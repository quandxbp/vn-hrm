# Copy to .env.worker on the VPS (not committed). Generate: openssl rand -hex 32
WORKER_TOKEN=
WORKER_RETENTION_HOURS=72
WORKER_RUN_WINDOW=
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
SYNTH_BACKEND=local
LLM_MODEL_PATH=/models/llm/Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_CTX=12288
# Final review text + rubric (one call per session). gemini = Free Tier key of Kim Academy; Google may
# use the input for training, so only the fuzzy-pseudonymized transcript is sent (never media/names).
SYNTH_REDUCE_BACKEND=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
# Only for SYNTH_BACKEND/SYNTH_REDUCE_BACKEND=api (OpenAI-compatible; pseudonymized transcript only):
SYNTH_API_BASE=
SYNTH_API_KEY=
SYNTH_API_MODEL=
