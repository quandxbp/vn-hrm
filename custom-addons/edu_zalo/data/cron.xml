<odoo noupdate="1">
    <record id="cron_zalo_schedule" model="ir.cron">
        <field name="name">GVNN: Gửi lịch học Zalo</field>
        <field name="model_id" ref="model_edu_zalo_config"/>
        <field name="state">code</field><field name="code">model._cron_send()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
        <field name="numbercall">-1</field><field name="active" eval="True"/>
    </record>
</odoo>
