<odoo>
    <record id="vnpt_hr_applicant_view_form" model="ir.ui.view">
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <field name="partner_name" position="replace">
                <field name="partner_name" placeholder="VD: Nguyễn Văn A"/>
            </field>

            <field name="user_id" position="replace" >
                <field name="user_id" widget="many2one_avatar_user" string="Người tuyển dụng"/>
            </field>

        </field>
    </record>
</odoo>