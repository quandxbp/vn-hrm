<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr.view_employee_filter" model="ir.ui.view">
        <field name="name">hr.employee.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Employees">
                <field name="name" string="Employee" filter_domain="['|', ('work_email', 'ilike', self), ('name', 'ilike', self)]"/>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" enable_counters="1"/>
                    <field name="department_id" icon="fa-users" enable_counters="1"/>
                </searchpanel>
                <field name="parent_id" string="Manager"/>
                <field name="job_id" string="Chức vụ"/>
                <field name="job_title" string="Chức danh"/>

                <separator/>
                <filter string="Unread Messages" name="message_needaction" domain="[('message_needaction', '=', True)]" groups="mail.group_mail_notification_type_inbox"/>
                <separator/>

                <filter invisible="1" string="Late Activities" name="activities_overdue"
                    domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Today Activities" name="activities_today"
                    domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Future Activities" name="activities_upcoming_all"
                    domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter name="my_team" string="Cùng nhóm" domain="[('parent_id.user_id', '=', uid)]"/>
                <filter name="my_department" string="Cùng bộ phận" domain="[('member_of_department', '=', True)]"/>

                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_manager" string="Manager" domain="[]" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_department" string="Department" domain="[]" context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Job" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter name="group_start" string="Ngày tạo " domain="[]" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Define your custom form view -->
    <record id="vnpt_view_employee_tree_inherit" model="ir.ui.view">
        <field name="name">vnpt.hr.employee.tree</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" string="Mã"  />
            </field>
            <field name="name" position="replace">
                <field name="name" class="text text-primary bold-text"  />
            </field>

            <field name="activity_ids" position="replace" />
            <field name="activity_user_id" position="replace" />
            <field name="activity_date_deadline" position="replace" />
            <field name="first_contract_date" position="replace" />
            <field name="department_id" position="replace" >
                <field name="department_id" string="Bộ phận/Phòng ban" optional="hide"/>
                <field name="department_name" string="Bộ phận/Phòng ban"/>
            </field>

        </field>
    </record>

    <record id="vnpt_view_employee_form" model="ir.ui.view">
        <field name="name">Nhân sự</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form class="employee-form">
                <field name="active" invisible="1"/>
                <field name="user_id" invisible="1"/>
                <field name="user_partner_id" invisible="1"/>
                <field name="image_128" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="child_ids" invisible="1" />
                <field name="contract_warning" invisible="1"/>
                <field name="employee_type" invisible="1"/>
                <field name="insurance_count" invisible="1" />
                <field name="write_date" invisible="1" />

                <header>
                    <button name="action_open_insurance"
                            icon="fa-plus"
                            string="Thêm HS Bảo hiểm" type="object" groups="hr.group_hr_user"
                            invisible="insurance_count != 0"/>
                </header>

                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_insurance" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="insurance_count == 0"
                                context="{'default_employee_id': id}" >
                            <div class="o_stat_info">
                                <span class="o_stat_value text-info">
                                    <field name="insurance_count"/>
                                </span>
                                <span class="o_stat_text text-info">
                                    HS bảo hiểm
                                </span>
                            </div>
                        </button>

                        <button name="action_open_contract"
                            class="oe_stat_button"
                            icon="fa-book"
                            type="object"
                            groups="hr_contract.group_hr_contract_manager"
                            context="{'default_employee_id': id}"
                            invisible="employee_type not in ['employee', 'student', 'trainee']">
                            <div invisible="not first_contract_date" class="o_stat_info">
                                <span class="o_stat_text text-success" invisible="contract_warning" title="In Contract Since"> HĐ kể từ</span>
                                <span class="o_stat_value text-success" invisible="contract_warning">
                                    <field name="first_contract_date" readonly="1"/>
                                </span>
                                <span class="o_stat_text text-danger" invisible="not contract_warning" title="In Contract Since">
                                    HĐ kể từ
                                </span>
                                <span class="o_stat_value text-danger" invisible="not contract_warning">
                                    <field name="first_contract_date" readonly="1"/>
                                </span>
                            </div>
                            <div invisible="first_contract_date" class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="contracts_count"/>
                                </span>
                                <span invisible="contracts_count != 1" class="o_stat_text text-danger" >
                                    Tạo hợp đồng
                                </span>
                                <span invisible="contracts_count == 1" class="o_stat_text text-danger">
                                    Hợp đồng
                                </span>
                            </div>
                        </button>
                        <button name="%(hr_org_chart.action_hr_employee_org_chart)d" icon="fa-users" type="action" context="{'hierarchy_res_id': id}" invisible="not parent_id and not child_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sơ đồ tổ chức</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="col-100" style="height:30px" />
                    <div class="row">
                        <div class="col-12 top-head">
                            <div class="div_avar_top">
                                <pre class="bg_green" style="background-color: unset !important;" />
                                <div class="img_avatar_top show_image_default">
                                    <field name="image_1920" widget="image" class="vnpt_oe_avatar m-0"
                                       options="{'zoom': true, 'preview_image':'avatar_128'}"/>
                                </div>
                            </div>
                            <div class="div_head_top row">
                                <div class="col-12">
                                    <h4 class="d-flex flex-row align-items-center" style="font-size: min(3.5vw, 2rem);">
                                        <span invisible="not code"><field name="code" /> - </span>
                                        <span style="padding-left: 5px"><field name="name" placeholder="Họ và tên" required="True" /></span>

                                    </h4>

                                    <h5>
                                        <label for="job_id" string="Chức vụ: " />
                                        <span class="pl-3" style="padding-right: 5px !important" />
                                        <field name="job_id" nolabel="1" class="w-50 pl-3"
                                               placeholder="Chọn chức vụ..."
                                               options="{'no_quick_create':True,'no_create_edit':True, 'no_open': True}"/>
                                        <br/>
                                        <label for="job_title" string="Chức danh: " style="padding-right: 5px !important" />
                                        <span class="pl-3" style="padding-right: 5px !important" />
                                        <field name="job_title" nolabel="1" class="w-50 pl-3"
                                               placeholder="Nhập chức danh..."/>
                                        <br/>
                                        <label for="department_id" string="Đơn vị / Phòng ban: " />
                                        <span class="pl-3" style="padding-right: 5px !important" />
                                        <field name="department_id" nolabel="1" class="w-50"
                                               options="{'no_quick_create':True,'no_create_edit':True, 'no_open': True}" />
                                        <br/>
                                        <label for="category_ids" string="Từ khoá: " />
                                        <span class="pl-3" style="padding-right: 5px !important" />
                                        <field name="category_ids" widget="many2many_tags"
                                               options="{'color_field': 'color', 'no_create_edit': True}"
                                               placeholder="Chọn từ khoá..." groups="hr.group_hr_user"/>
                                    </h5>
                                </div>
                                <div class="mt-4" />
                            </div>
                        </div>
                    </div>

                    <group col="12" >
                        <group colspan="4" >
                            <separator string="Thông tin quản lý" groups="hr.group_hr_manager" class="text-primary"/>
                            <field name="user_id" groups="hr.group_hr_manager" string="Người dùng hệ thống"
                                   options="{'no_quick_create':True,'no_create_edit':True}"
                                   placeholder="Chọn người dùng..."/>

                            <field name="pin" string="Mã PIN định danh" groups="hr_attendance.group_hr_attendance_manager"/>
                            <field name="barcode"  string="Mã barcode" groups="hr_attendance.group_hr_attendance_manager"/>

                            <separator string="Thông tin liên hệ" class="text-primary"/>
                            <field name="different_name" string="Tên gọi khác: "/>
                            <label for="private_street" string="Địa chỉ"/>
                            <div class="o_address_format">
                                <field name="private_street" placeholder="Địa chỉ thường trú..." class="o_address_street" />
                                <field name="private_street2" placeholder="Địa chỉ tạm trú..." class="o_address_street" />
                                <field name="private_city" placeholder="Quận/Huyện" class="o_address_city" style="width: 45% !important"  />
                                <field name="private_state_id" class="o_address_state" placeholder="Tỉnh/Thành phố" style="width: 45% !important"
                                       options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': private_country_id}" />
                                <field name="private_country_id" placeholder="Quốc gia" class="o_address_country"
                                       options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" />
                            </div>

                            <field name="work_email" widget="email" string="Email công việc: "
                                   placeholder="congviec@gmail.com"/>
                            <field name="private_email" widget="email" string="Email cá nhân: "
                                   placeholder="canhan@gmail.com"/>
                            <field name="gender" string="Giới tính: "/>
                            <field name="work_phone" string="Điện thoại cố định: " widget="phone" />
                            <field name="mobile_phone" string="Di động: " widget="phone"/>

                            <field name="birthday" string="Ngày sinh: "/>
                            <field name="marital" string="Tình trạng hôn nhân: " />
                            <field name="total_dependant" string="Số người phụ thuộc:" />

                            <!-- Thông tin công việc -->
                            <separator string="Thông tin công việc" class="text-primary"/>
                            <field name="parent_id" string="Người quản lý"
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}"
                                   widget="many2one_avatar_user"/>
                            <field name="coach_id"
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}"
                                   string="Người hướng dẫn" widget="many2one_avatar_user"/>
                            <field name="leave_manager_id"
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}"
                                   string="Quản lý nghỉ phép" widget="many2one_avatar_user"/>
                            <field name="so_bhxh" string="Số BHXH: "/>

                            <!-- Thông tin chung -->
                            <separator string="Thông tin chung" class="text-primary"/>
                            <field name="identification_id" string="Số CMND/CCCD: "/>
                            <field name="identification_date" string="Ngày cấp CMND/CCCD: "/>
                            <field name="identification_place" string="Nơi cấp CMND/CCCD: "/>
                            <field name="passport_id" string="Số Passport: "/>
                            <field name="passport_date" string="Ngày cấp Passport: "/>
                            <field name="passport_place" string="Nơi cấp Passport: "/>

                            <field name="place_of_birth" string="Nơi sinh: " />
                            <field name="nguyen_quan" string="Nguyên quán:" />
                            <field name="country_id" string="Quốc tịch: "
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="ethnicity_id" string="Dân tộc: "
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="religion_id" string="Tôn giáo: "
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}" />

                            <!-- Thông tin tuyển dụng -->
                            <separator string="Thông tin tuyển dụng" class="text-primary"/>
                            <field name="ngay_td" string="Ngày tuyển dụng: "/>
                            <field name="quyet_dinh_td" string="Căn cứ VB (QĐ) về kế hoạch tuyển dụng: "/>

                            <field name="don_vi_tuyen_dung" string="Đơn vị tuyển dụng: "/>
                            <field name="vi_tri_tuyen_dung" string="Vị trí tuyển dụng: "/>
                            <field name="ngay_vao_don_vi" string="Ngày vào đơn vị: "/>
                            <field name="ngay_vao_don_vi_ct" string="Ngày vào đơn vị CT: "/>

                            <!-- Trình độ -->
                            <separator string="Trình độ" class="text-primary"/>

                            <field name="trinh_do_van_hoa_id" string="Trình độ văn hóa: "
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="thuoc_he" string="Thuộc hệ: "/>
                            <field name="hoc_ham_id" string="Học hàm: "
                                   options="{'no_open': True}" />
                            <field name="certificate" string="Trình độ đào tạo (Học vị): "/>
                            <field name="study_field" string="Chuyên ngành đào tạo: "/>
                            <field name="study_school" string="Cơ sở đào tạo: "/>
                            <field name="ly_luan_chinh_tri" string="Lý luận chính trị: " />
                            <field name="quan_ly_nha_nuoc" string="Quản lý nhà nước: "/>
                            <field name="ky_nang_mem" />

                            <!-- Danh hiệu phong tặng -->
<!--                            <separator string="Danh hiệu phong tặng"/>-->

                            <!-- Thông tin sức khoẻ -->
                            <separator string="Thông tin sức khoẻ" class="text-primary"/>
                            <field name="tinh_trang_suc_khoe" string="Tình trạng: " />
                            <field name="chieu_cao" string="Chiều cao(cm): " />
                            <field name="can_nang" string="Cân nặng(kg): " />
                            <field name="nhom_mau" string="Nhóm máu: " />

                            <!-- Thông tin ngân hàng/thuế -->
                            <separator string="Thông tin ngân hàng/thuế" class="text-primary"/>
                            <field name="ma_so_thue" string="Mã số thuế: " />
                            <field name="bank_id" string="Ngân hàng: "
                                   options="{'no_quick_create':True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="bank_branch" string="Chi nhánh: " />
                            <field name="bank_account" string="Số tài khoản: " />

                            <!-- Thông tin Đảng -->
                            <separator string="Thông tin Đảng" class="text-primary"/>
                            <field name="is_dang_vien" string="Là đảng viên: "/>
                            <field name="ngay_vao_dang" string="Ngày vào Đảng: "
                                   required="is_dang_vien"
                                   invisible="not is_dang_vien" />
                            <field name="chi_bo_dang" string="Tại chi bộ Đảng: " invisible="not is_dang_vien" />
                            <field name="ngay_vao_dang_chinh_thuc" string="Ngày vào Đảng CT: " invisible="not is_dang_vien" />
                            <field name="chi_bo_dang_chinh_thuc" string="Tại chi bộ Đảng: " invisible="not is_dang_vien" />
                            <field name="chuc_vu_dang" string="Chức vụ Đảng: " invisible="not is_dang_vien" />

                            <!-- Thông tin Đoàn -->
                            <separator string="Thông tin Đoàn" class="text-primary"/>
                            <field name="is_doan_vien" string="Là đoàn viên: "/>
                            <field name="ngay_vao_doan" string="Ngày vào đoàn: "
                                    required="is_doan_vien"
                                   invisible="not is_doan_vien" />
                            <field name="noi_ket_nap_doan" string="Nơi kết nạp: "
                                   invisible="not is_doan_vien" />
                            <field name="chuc_vu_doan" string="Chức vụ đoàn: "
                                   invisible="not is_doan_vien"/>
                        </group>
                        <group colspan="8">
                            <!-- Thông tin Gia đình -->
                            <separator string="Thông tin gia đình" class="text-primary"/>
                            <field name="employee_relatives_ids" string=" ">
                                <tree>
                                    <field name="relation_ship_id" />
                                    <field name="name" />
                                    <field name="birth_year" />
                                    <field name="hometown" />
                                    <field name="address" />
                                    <field name="job_title" />
                                    <field name="work_unit" />
                                    <field name="is_dependent" />
                                    <field name="is_dead" />
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name" />
                                            <field name="birth_year" />
                                            <field name="hometown" />
                                            <field name="work_unit" />
                                            <field name="attachment_id" widget="binary"/>
                                        </group>
                                        <group>
                                            <field name="relation_ship_id"
                                                   options="{'no_open':True}" />
                                            <field name="address" />
                                            <field name="job_title" />
                                            <field name="org_name" />
                                            <field name="is_dead" />
                                            <field name="is_dependent" />
                                        </group>
                                    </group>
                                    <separator string="Ghi chú "/>
                                    <field name="note"/>

                                </form>
                            </field>
                            <!-- Thông tin Gia đình chính -->
                            <separator string="Thông tin gia đình chính sách" class="text-primary"/>
                            <field name="employee_policy_relatives_ids" string=" ">
                                <tree>
                                    <field name="relation_ship_id" />
                                    <field name="name" />
                                    <field name="relatives_type" />
                                    <field name="fight_place" />
                                    <field name="fight_year" />
                                    <field name="dead_year" />
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name" />
                                            <field name="fight_year" />
                                            <field name="relatives_type" />
                                            <field name="attachment_id" widget="binary"/>
                                        </group>
                                        <group>
                                            <field name="relation_ship_id"
                                                   options="{'no_open':True}" />
                                            <field name="fight_place" />
                                        </group>
                                    </group>

                                    <separator string="Ghi chú "/>
                                    <field name="note"/>
                                </form>
                            </field>

                            <separator string="Trình độ học vấn/ Thông tin đào tạo" class="text-primary" />
                            <field name="employee_education_ids" string=" ">
                                <tree>
                                    <field name="date_start" />
                                    <field name="date_end" />
                                    <field name="level_id" />
                                    <field name="major" />
                                    <field name="school" />
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="level_id" options="{'no_quick_create':True,'no_create_edit':True}" />
                                            <field name="school" />
                                            <field name="date_start" string="Thời gian học"
                                                   widget="daterange" options="{'end_date_field': 'date_end'}"/>
                                            <field name="date_end" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="type" />
                                            <field name="major" />
                                        </group>
                                    </group>
                                    <group>
                                        <field name="attachment_ids" widget="many2many_binary" />
                                    </group>

                                    <separator string="Ghi chú "/>
                                    <field name="note"/>
                                </form>
                            </field>

                            <separator string="Chứng chỉ/chứng nhận" class="text-primary" />
                            <field name="employee_certificate_ids" string=" ">
                                <tree>
                                    <field name="date_start" />
                                    <field name="date_end" />
                                    <field name="date" />
                                    <field name="name" />
                                    <field name="type" string="Loại chứng chỉ"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name" />
                                            <field name="type" />
                                            <field name="date" />
                                            <field name="date_start" string="Thời gian áp dụng"
                                                   widget="daterange" options="{'end_date_field': 'date_end'}"/>
                                            <field name="date_end" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="type" />
                                            <field name="major" />
                                        </group>
                                    </group>
                                    <group>
                                        <field name="attachment_ids" widget="many2many_binary" />
                                    </group>

                                    <separator string="Ghi chú "/>
                                    <field name="note"/>
                                </form>
                            </field>

                            <separator string="Quá trình công tác" class="text-primary" />
                            <field name="employee_work_process_ids" string=" ">
                                <tree>
                                    <field name="date_start" />
                                    <field name="date_end" />
                                    <field name="job_title" />
                                    <field name="work_unit" />
                                    <field name="leave_job_reason" />
                                    <field name="salary" />
                                    <field name="description" />
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="employee_id" invisible="1" />
                                            <field name="work_unit" />
                                            <field name="job_type" />
                                            <field name="salary" />

                                        </group>
                                        <group>
                                            <field name="job_title" />
                                            <field name="job_position" />
                                            <field name="leave_job_reason" />

                                        </group>
                                    </group>
                                    <group>
                                        <field name="date_start" string="Thời gian công tác"
                                                   widget="daterange" options="{'end_date_field': 'date_end'}"/>
                                            <field name="date_end" invisible="1"/>
                                    </group>
                                    <separator string="Mô tả "/>
                                    <field name="description" />

                                    <separator string="Ghi chú "/>
                                    <field name="note"/>
                                </form>
                            </field>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tài liệu đính kèm" name="attachment">
                            <div>
                                <group>
                                    <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                                </group>
