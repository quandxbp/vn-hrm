<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hr_insurance_search" model="ir.ui.view">
        <field name="name">hr.insurance.search</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="department_id" string="Phòng/Ban" icon="fa-users" enable_counters="1"/>
                </searchpanel>

                <field name="employee_id" string="Nhân viên" />
                <field name="so_so" string="Số sổ" />
                <field name="so_the_bhyt" string="Số thẻ BHTN" />

                <group expand="0" string="Group By">
                    <filter name="group_department" string="Phòng ban/Bộ phận" domain="[]" context="{'group_by':'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_insurance_view_kanban" model="ir.ui.view">
        <field name="name">hr.insurance.kanban</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_employee_kanban" >
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <t t-if="record.image_1024.raw_value">
                                <field name="image_1024" class="o_kanban_image_fill_left d-block"
                                       preview_image="image_128" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}"/>
                            </t>
                            <t t-elif="record.image_128.raw_value">
                                <field name="image_128" class="o_kanban_image_fill_left d-block"
                                       widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}"/>
                            </t>
                            <div t-else="" class="o_kanban_image_fill_left d-flex align-items-center justify-content-center bg-100 bg-gradient">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-75 h-75 opacity-50" viewBox="0 0 20 20">
                                    <g fill="currentColor">
                                        <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                        <circle cx="10" cy="5.5" r="4.5"/>
                                    </g>
                                </svg>
                            </div>

                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <span t-if="record.employee_code.raw_value">
                                                <field name="employee_code" />
                                                <span> - </span>
                                            </span>

                                            <field name="employee_name" placeholder="Tên nhân sự"/>
                                        </strong>
                                        <span t-if="record.department_name.raw_value" class="o_kanban_record_subtitle">
                                            <field name="department_name"/>
                                        </span>
                                    </div>
                                </div>
                                <ul>
                                    <li t-if="record.so_so.raw_value" class="o_text_overflow">
                                        <i class="fa fa-fw me-2 fa-book text-primary" title="Số sổ BHXH"/>
                                        <field name="so_so"/>
                                    </li>
                                    <li t-if="record.so_the_bhyt.raw_value" class="o_force_ltr">
                                        <i class="fa fa-fw me-2 fa-address-card text-primary" title="Số thẻ BHYT"/>
                                        <field name="so_the_bhyt"/>
                                    </li>
                                </ul>
                            </div>
                            <div class="oe_kanban_content o_hr_employee_kanban_bottom position-absolute bottom-0 start-0 end-0">
                                <div class="o_kanban_record_bottom mt-3">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right">
                                        <div class="hr_avatar mb-1 ms-2 me-n1">
                                            <field name="employee_id" widget="many2one_avatar_user" readonly="1"/>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_insurance_view_tree" model="ir.ui.view">
        <field name="name">hr.insurance.tree</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <tree >
                <field name="employee_id" widget="many2one_avatar_user" />
                <field name="so_so" />
                <field name="start_date_bhxh" />
                <field name="so_the_bhyt" />
                <field name="position" />
            </tree>
        </field>
    </record>

    <record id="hr_insurance_view_form" model="ir.ui.view">
        <field name="name">hr.insurance.form</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <div class="oe_title">
                        <h1>
                             <field name="employee_id" readonly="id"
                                    widget="many2one_avatar_user" placeholder="Chọn nhân viên ..."/>
                        </h1>
                    </div>
                    <separator string="Thông tin liên hệ"/>
                    <group>
                        <group>
                            <field name="department_name" string="Đơn vị/Phòng ban"/>
                            <field name="identification_id" string="Số CMND/CCCD"/>
                            <field name="identification_date" string="Ngày cấp"/>
                            <field name="identification_place" string="Nơi cấp"/>
                        </group>
                        <group>
                            <field name="employee_code" string="Mã NV" />
                            <field name="gender" string="Giới tính"/>
                            <field name="birthday" string="Ngày sinh"/>
                        </group>
                    </group>

                    <separator string="Thông tin hồ sơ"/>
                    <group>
                        <group>
                            <field name="so_so" />
                            <field name="start_date_bhxh" />
                            <field name="end_date_bhxh" />
                            <field name="start_date_bhtn" />
                        </group>
                        <group>
                            <field name="ma_don_vi_quan_ly_bhxh" />
                            <field name="co_quan_quan_ly_bhxh" />

                            <field name="so_status" />
                        </group>
                        <group>
                            <field name="so_the_bhyt" />
                            <field name="regist_place_id" options="{'no_quick_create':True,'no_create_edit':True}"/>

                        </group>
                        <group>
                            <field name="giao_the_date" />
                            <field name="tra_the_date" />
                        </group>

                    </group>

                    <separator string="Lương bảo hiểm"/>
                    <group>
                        <group>
                            <field name="latest_salary_id" invisible="1" />
                            <field name="salary_date" />
                            <field name="position" />
                            <field name="salary_level" />
                        </group>
                        <group>
                            <field name="salary_coefficient" />
                            <field name="allowance_coefficient" />
                            <field name="insurance_salary" />
                        </group>
                    </group>

<!--                    <notebook invisible="not write_date">-->
                    <notebook>
                        <page string="Lịch sử đóng BHXH" name="insurance_history">
                            <field name="salary_ids" >
                                <tree>
                                    <field name="date_salary" />
                                    <field name="state" />
                                    <field name="position" />
                                    <field name="salary_level" />
                                    <field name="salary_coefficient" />
                                    <field name="allowance_coefficient" />
                                    <field name="insurance_salary" string="Mức đóng BHXH"/>
                                    <field name="department_id" />
                                    <field name="description" />
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="date_salary" string="Từ ngày" />
                                            <field name="state" string="Trạng thái" />
                                            <field name="position" string="Chức danh bảo hiểm" />
                                            <field name="department_id" string="Đơn vị" />
                                        </group>
                                        <group>
                                            <field name="salary_level" string="Bậc lương BHXH" />
                                            <field name="salary_coefficient" string="Hệ số lương đóng BHXH" />
                                            <field name="allowance_coefficient" string="Hệ số phụ cấp đóng BHXH" />
                                            <field name="insurance_salary" string="Mức đóng BHXH"/>
                                        </group>
                                        <separator string="Diễn giải"/>
                                        <field name="description"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" options="{'post_refresh': 'recipients'}"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hr_insurance_action" model="ir.actions.act_window">
        <field name="name">Hồ sơ bảo hiểm</field>
        <field name="res_model">hr.insurance</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="vnpt_hrm.hr_insurance_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('vnpt_hrm.hr_insurance_view_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('vnpt_hrm.hr_insurance_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('vnpt_hrm.hr_insurance_view_form')})]"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Nhập các tiêu chí để tìm kiếm thông tin về Hồ sơ bảo hiểm của nhân sự đã cập nhật trên hệ thống.
          </p><p>
            Nhập các tiêu chí tìm kiếm liên quan đến cán bộ CCVC bạn muốn tìm và nhấn Enter hoặc click vào nút Tìm kiếm.
            Trong giới hạn quyền dữ liệu được cấp cho tài khoản, bạn có thể dễ dàng tìm thấy tất cả thông tin bạn cần cho mỗi cán bộ CCVC
          </p>
        </field>
    </record>

    <record id="hr_insurance_regist_place_view_tree" model="ir.ui.view">
        <field name="name">hr.insurance.regist.place.tree</field>
        <field name="model">hr.insurance.regist.place</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code" />
                <field name="name" />
                <field name="address" />
            </tree>
        </field>
    </record>


    <record id="hr_insurance_regist_place_action" model="ir.actions.act_window">
        <field name="name">Đăng ký khám chưa bệnh</field>
        <field name="res_model">hr.insurance.regist.place</field>
        <field name="view_mode">tree</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('vnpt_hrm.hr_insurance_regist_place_view_tree')})]"/>
    </record>
</odoo>
