        <field name="tax_rule_id" ref="hr_tax_rule_vietnam"/>
        <field name="lower_limit">10000000</field>
        <field name="tax_rate">15</field>
    </record>
    <record id="hr_tax_bracket_4" model="hr.tax.bracket">
        <field name="tax_rule_id" ref="hr_tax_rule_vietnam"/>
        <field name="lower_limit">18000000</field>
        <field name="tax_rate">20</field>
    </record>
    <record id="hr_tax_bracket_5" model="hr.tax.bracket">
        <field name="tax_rule_id" ref="hr_tax_rule_vietnam"/>
