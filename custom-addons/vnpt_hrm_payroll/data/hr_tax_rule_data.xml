<odoo>
    <record id="hr_tax_rule_vietnam" model="hr.tax.rule">
        <field name="name">Biểu Thuế Lũy Tiến Từng Phần</field>
        <field name="tax_policy">progressive</field>
        <field name="apply_deduction">True</field>
        <field name="base_deduction">11000000</field>
        <field name="dependent_deduction">4400000</field>
    </record>

    <record id="hr_tax_bracket_1" model="hr.tax.bracket">
