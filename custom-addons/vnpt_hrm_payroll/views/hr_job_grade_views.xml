<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_job_grade_tree" model="ir.ui.view">
        <field name="name">hr.job.grade.tree</field>
        <field name="model">hr.job.grade</field>
        <field name="arch" type="xml">
            <tree>
                <field name="currency_id" column_invisible="1" />
                <field name="job_id"/>
                <field name="category_id" string="Nhóm bậc lương" />
                <field name="grade_level" class="text-primary"/>
                <field name="salary_coefficient"/>
                <field name="base_wage" widget="monetary"/>
                <field name="insurance_wage" widget="monetary"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_job_grade_form" model="ir.ui.view">
        <field name="name">hr.job.grade.form</field>
        <field name="model">hr.job.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="currency_id" invisible="1" />
                    <group>
                        <group>
                            <field name="category_id" string="Nhóm bậc lương" />
                            <field name="job_id"/>
                            <field name="grade_level"/>
                        </group>
                        <group>
                            <field name="salary_coefficient"/>
                            <field name="base_wage" widget="monetary"/>
                            <field name="insurance_wage" widget="monetary"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_job_grade_search" model="ir.ui.view">
        <field name="name">hr.job.grade.search</field>
        <field name="model">hr.job.grade</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="grade_level"/>
                <field name="category_id" />

                <searchpanel>
                    <field name="category_id" string="Nhóm" icon="fa-users" enable_counters="1"/>
                    <field name="job_id" string="Chức vụ" icon="fa-calendar" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hr_job_grade" model="ir.actions.act_window">
        <field name="name">Bậc Lương</field>
        <field name="res_model">hr.job.grade</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hr_job_grade_search"/>
    </record>

    <record id="view_hr_job_grade_category_tree" model="ir.ui.view">
        <field name="name">hr.job.grade.category.tree</field>
        <field name="model">hr.job.grade.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_job_grade_category" model="ir.actions.act_window">
        <field name="name">Loại bậc Lương</field>
        <field name="res_model">hr.job.grade.category</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>