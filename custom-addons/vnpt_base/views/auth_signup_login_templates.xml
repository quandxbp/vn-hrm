<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="vnpt_login_field" inherit_id="auth_signup.fields" name="Auth Signup/ResetPassword form fields">

            <xpath expr="//label[@for='login']" position="replace">
                <label for="login">Tên tài khoản</label>
            </xpath>

            <xpath expr="//label[@for='name']" position="replace">
                <label for="name">Họ và tên</label>
            </xpath>

            <xpath expr="//label[@for='password']" position="replace">
                <label for="password">Mật khẩu</label>
            </xpath>

            <xpath expr="//label[@for='confirm_password']" position="replace">
                <label for="confirm_password">Xác nhận mật khẩu</label>
            </xpath>
    </template>

    <template id="vnpt_login" inherit_id="auth_signup.signup" name="Custom Login">
        <xpath expr="//form[hasclass('oe_signup_form')]" position="replace">
            <form class="oe_signup_form" role="form" method="post" t-if="not message">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <t t-call="auth_signup.fields">
                        <t t-set="only_passwords" t-value="bool(token and not invalid_token)"/>
                    </t>

                    <p class="alert alert-danger" t-if="error" role="alert">
                        <t t-esc="error"/>
                    </p>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                    <input type="hidden" name="token" t-att-value="token"/>
                    <div class="text-center oe_login_buttons pt-3">
                        <button type="submit" class="btn btn-primary btn-block"> Đăng ký</button>
                        <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm" role="button">Bạn đã có tài khoản?</a>
                        <div class="o_login_auth"/>
                    </div>
            </form>
        </xpath>
    </template>
</odoo>