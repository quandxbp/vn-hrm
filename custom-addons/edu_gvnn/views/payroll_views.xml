<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_payroll_period_tree" model="ir.ui.view">
        <field name="name">edu.payroll.period.tree</field>
        <field name="model">edu.payroll.period</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'locked'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_hours"/>
                <field name="total_amount" sum="Tổng"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_payroll_period_form" model="ir.ui.view">
        <field name="name">edu.payroll.period.form</field>
        <field name="model">edu.payroll.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Tính lương"
                            invisible="state != 'open' or not id"/>
                    <button name="action_lock" type="object" string="Chốt lương" class="btn-primary"
                            invisible="state != 'open' or not id"
                            confirm="Sau khi chốt, các buổi học trong tháng sẽ bị khoá không cho sửa. Tiếp tục?"/>
                    <button name="action_unlock" type="object" string="Mở khoá" groups="base.group_system"
                            invisible="state != 'locked'"
                            confirm="Mở khoá cho phép sửa lại các buổi học trong tháng. Tiếp tục?"/>
                    <button name="%(action_report_edu_payroll_agency)d" type="action"
                            string="In bảng đối soát Agency" invisible="not id"/>
                    <button name="%(action_report_edu_payroll_direct)d" type="action"
                            string="In bảng lương GV trực tiếp" invisible="not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,locked"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state == 'locked'"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="total_hours"/>
                            <field name="total_amount"/>
                            <field name="locked_by"/>
                            <field name="locked_date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom" create="0" delete="0"
                              decoration-danger="status in ('no_rate', 'agency_diff')"
                              decoration-warning="status == 'warning'" decoration-muted="status == 'no_session'">
                            <field name="teacher_id" readonly="1"/>
                            <field name="teacher_type" readonly="1"/>
                            <field name="session_count" readonly="1" sum="Tổng"/>
                            <field name="hours" readonly="1" sum="Tổng"/>
                            <field name="rate_end_month" readonly="1"/>
                            <field name="amount" readonly="1" sum="Tổng"/>
                            <field name="warning_count" readonly="1"/>
                            <field name="agency_hours"/>
                            <field name="agency_amount"/>
                            <field name="diff_hours" readonly="1"/>
                            <field name="diff_amount" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_edu_payroll_period" model="ir.actions.act_window">
        <field name="name">Kỳ lương</field>
        <field name="res_model">edu.payroll.period</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
