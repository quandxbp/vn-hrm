<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_session_tree" model="ir.ui.view">
        <field name="name">edu.session.tree</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <tree class="edu_list" js_class="edu_session_list" editable="bottom" expand="1" default_order="week_id asc,date asc,time_start desc,id desc" decoration-muted="state == 'cancel'"
                  decoration-info="session_type == 'testing' and state == 'done'">
                <header>
                    <button name="%(action_edu_import_wizard)d" type="action" display="always"
                            string="Nhập lịch sử" icon="fa-upload" class="edu_session_action_file"
                            help="Nhập buổi học quá khứ từ sheet 2.ĐIỂM DANH."
                            groups="edu_gvnn.group_edu_manager"/>
                    <button name="%(action_edu_clone_week_wizard)d" type="action" display="always"
                            string="Tạo tuần mới" icon="fa-calendar-plus-o"
                            help="Tạo tuần mới bằng cách sao chép lịch của một tuần trước đó."
                            groups="edu_gvnn.group_edu_manager"/>
                    <button name="%(action_edu_export_week_wizard)d" type="action" display="always"
                            string="Xuất điểm danh" icon="fa-file-excel-o" class="edu_session_action_file"
                            help="Xuất điểm danh của tuần đã chọn theo mẫu Weekly."/>
                </header>
                <field name="paid" column_invisible="1"/>
                <field name="week_id" widget="edu_session_week" readonly="1"/>
                <field name="date" widget="edu_weekday_date_badge" readonly="paid"/>
                <field name="weekday" widget="edu_weekday_badge"/>
                <field name="teacher_id" widget="edu_teacher_badge" readonly="paid" options="{'no_open': True}"/>
                <field name="session_type" optional="hide" readonly="paid"/>
                <field name="time_start" widget="float_time" readonly="paid"/>
                <field name="time_end" widget="float_time" readonly="paid"/>
                <field name="minutes" optional="hide" readonly="paid"/>
                <field name="class_ids" widget="many2many_tags" readonly="paid"/>
                <field name="student_badge_data" column_invisible="1"/>
                <field name="attendee_ids" widget="edu_session_students" string="Danh sách học viên"
                       readonly="paid or session_type == 'testing'">
                    <tree editable="bottom">
                        <field name="student_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="present"/>
                    </tree>
                </field>
                <field name="google_drive_url" widget="url" optional="hide" readonly="paid"/>
                <field name="youtube_url" widget="url" optional="hide" readonly="paid"/>
                <field name="state" widget="edu_session_state_toggle" readonly="paid"/>
                <field name="warning" widget="badge" decoration-success="warning == 'ok'" decoration-danger="warning != 'ok'"/>
                <field name="paid_hours" optional="hide"/>
                <field name="teacher_amount" groups="edu_gvnn.group_edu_manager" optional="hide" sum="Tổng"/>
                <button name="get_formview_action" type="object" string="Chi tiết"
                        icon="fa-external-link" class="btn-link"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_session_video_tree" model="ir.ui.view">
        <field name="name">edu.session.video.tree</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <tree class="edu_list" js_class="edu_session_list" editable="bottom" create="0" delete="0"
                  expand="1" default_order="week_id asc,date asc,time_start desc,id desc"
                  decoration-muted="state == 'cancel'">
                <field name="paid" column_invisible="1"/>
                <field name="google_drive_url" column_invisible="1"/>
                <field name="youtube_url" column_invisible="1"/>
                <field name="student_badge_data" column_invisible="1"/>
                <field name="week_id" widget="edu_session_week" readonly="1"/>
                <field name="date" widget="edu_weekday_date_badge" readonly="1"/>
                <field name="weekday" widget="edu_weekday_badge" readonly="1"/>
                <field name="teacher_id" widget="edu_teacher_badge" readonly="1" options="{'no_open': True}"/>
                <field name="student_names" widget="edu_session_student_names" string="Danh sách học viên" readonly="1"/>
                <field name="state" widget="edu_session_state_toggle" readonly="1"/>
                <field name="recording_part_ids" widget="edu_session_video_links" string="Link GG Drive"
                       readonly="paid" options="{'link_field': 'google_drive_url'}">
                    <tree editable="bottom">
                        <field name="number"/>
                        <field name="google_drive_url"/>
                        <field name="youtube_url"/>
                    </tree>
                </field>
                <field name="recording_part_ids" widget="edu_session_video_links" string="Link YouTube"
                       readonly="paid" options="{'link_field': 'youtube_url'}">
                    <tree editable="bottom">
                        <field name="number"/>
                        <field name="google_drive_url"/>
                        <field name="youtube_url"/>
                    </tree>
                </field>
            </tree>
        </field>
    </record>

    <record id="view_edu_session_form" model="ir.ui.view">
        <field name="name">edu.session.form</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <header>
                    <button name="action_cancel" type="object" string="Nghỉ buổi học"
                            invisible="state != 'done'"
                            confirm="Buổi học này sẽ không trừ học phí học viên và không tính lương giáo viên. Tiếp tục?"/>
                    <button name="action_restore" type="object" string="Khôi phục" class="btn-primary"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="done,cancel"/>
                </header>
                <sheet>
                    <div class="edu_profile_heading">
                        <span class="edu_profile_icon fa fa-calendar" aria-hidden="true"/>
                        <div><div class="edu_eyebrow">LỊCH GIẢNG DẠY</div><h1 class="edu_form_title">Thông tin buổi học</h1></div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="warning == 'ok'">
                        Cảnh báo: <field name="warning" class="oe_inline"/>
                    </div>
                    <group>
                        <group string="Lịch học và giáo viên">
                            <field name="session_type"/>
                            <field name="date"/>
                            <field name="week_id"/>
                            <field name="weekday"/>
                            <field name="teacher_id"/>
                            <field name="class_ids" widget="many2many_tags"
                                   required="session_type == 'testing'"/>
                        </group>
                        <group string="Thời gian buổi học">
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="minutes"/>
                            <field name="student_hours" invisible="session_type == 'testing'"/>
                            <field name="teacher_hours"/>
                            <field name="paid_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Học viên" invisible="session_type == 'testing'">
                            <field name="attendee_ids">
                                <tree editable="bottom" decoration-muted="not present">
                                    <field name="student_id" options="{'no_create': True}"/>
                                    <field name="present"/>
                                    <field name="block_price"/>
                                    <field name="score"/>
                                    <field name="blocks" readonly="1"/>
                                    <field name="charge_amount" readonly="1" sum="Tổng"/>
                                    <button name="action_toggle_present" type="object" icon="fa-user-times"
                                            string="Đánh nghỉ" invisible="not present"
                                            class="text-danger"/>
                                    <button name="action_toggle_present" type="object" icon="fa-user-plus"
                                            string="Có mặt" invisible="present" class="text-success"/>
                                </tree>
                            </field>
                            <field name="extra_participants" placeholder="Người tham gia khác (không có trong danh sách học viên)"/>
                        </page>
                        <page name="session_videos" string="Video buổi học">
                            <group string="Phần 1" col="2">
                                <field name="google_drive_url" widget="url" string="Google Drive"
                                       placeholder="https://drive.google.com/file/d/.../view"/>
                                <field name="youtube_url" widget="url" string="YouTube"
                                       placeholder="https://youtu.be/..."/>
                            </group>
                            <separator string="Các đoạn bổ sung (Phần 2 trở đi)"/>
                            <div class="text-muted mb-2">Mỗi dòng là một đoạn video, gồm link Google Drive và link YouTube tương ứng.</div>
                            <field name="recording_part_ids" nolabel="1" class="edu_recording_parts">
                                <tree editable="bottom">
                                    <field name="number" width="100"/>
                                    <field name="google_drive_url" widget="url" string="Google Drive"/>
                                    <field name="youtube_url" widget="url" string="YouTube"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lương giáo viên" groups="edu_gvnn.group_edu_manager">
                            <group>
                                <field name="teacher_rate"/>
                                <field name="teacher_amount"/>
                                <field name="paid"/>
                            </group>
                        </page>
                        <page string="Ghi chú">
                            <group>
                                <field name="completion_note"/>
                            </group>
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_edu_session_search" model="ir.ui.view">
        <field name="name">edu.session.search</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="attendee_ids" string="Học viên" filter_domain="[('attendee_ids.student_id.name', 'ilike', self)]"/>
                <field name="class_ids"/>
                <field name="week_id"/>
                <filter name="today" string="Hôm nay" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Tháng này"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="done" string="Đã dạy" domain="[('state', '=', 'done')]"/>
                <filter name="cancel" string="Nghỉ buổi học" domain="[('state', '=', 'cancel')]"/>
                <filter name="lesson" string="Buổi học" domain="[('session_type', '=', 'lesson')]"/>
                <filter name="testing" string="Buổi testing" domain="[('session_type', '=', 'testing')]"/>
                <separator/>
                <filter name="has_warning" string="Có cảnh báo" domain="[('warning', '!=', 'ok')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_week" string="Tuần" context="{'group_by': 'week_id'}"/>
                    <filter name="group_date" string="Ngày" context="{'group_by': 'date:day'}"/>
                    <filter name="group_month" string="Tháng" context="{'group_by': 'date:month'}"/>
                    <filter name="group_teacher" string="Giáo viên" context="{'group_by': 'teacher_id'}"/>
                    <filter name="group_type" string="Loại buổi" context="{'group_by': 'session_type'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_session" model="ir.actions.act_window">
        <field name="name">Buổi học</field>
        <field name="res_model">edu.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_week': 1}</field>
    </record>
    <record id="action_edu_session_video" model="ir.actions.act_window">
        <field name="name">Video buổi học</field>
        <field name="res_model">edu.session</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_edu_session_video_tree"/>
        <field name="search_view_id" ref="view_edu_session_search"/>
        <field name="context">{'search_default_group_week': 1}</field>
    </record>
</odoo>
