<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_teacher_tree" model="ir.ui.view">
        <field name="name">edu.teacher.tree</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <tree class="edu_list">
                <field name="name"/>
                <field name="teaching_title"/>
                <field name="meeting_url" widget="url" optional="show"/>
                <field name="code"/>
                <field name="teacher_type" widget="badge" decoration-info="teacher_type == 'direct'" decoration-warning="teacher_type == 'agency'"/>
                <field name="agency_id"/>
                <field name="current_rate" groups="edu_gvnn.group_edu_manager"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_teacher_form" model="ir.ui.view">
        <field name="name">edu.teacher.form</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="edu_profile_heading">
                        <span class="edu_profile_icon fa fa-user" aria-hidden="true"/>
                        <div class="oe_title"><div class="edu_eyebrow">HỒ SƠ GIÁO VIÊN</div><h1><field name="name" placeholder="Tên giáo viên"/></h1></div>
                    </div>
                    <group>
                        <group string="Thông tin giảng dạy">
                            <field name="teaching_title"/>
                            <field name="meeting_url" widget="url" placeholder="https://meet.google.com/xxx-xxxx-xxx"/>
                            <field name="public_schedule_url" widget="url" readonly="1"/>
                            <field name="schedule_edit_url" widget="url" readonly="1" groups="edu_gvnn.group_edu_manager"/>
                            <field name="code"/>
                            <field name="teacher_type"/>
                            <field name="agency_id" required="teacher_type == 'agency'"
                                   invisible="teacher_type != 'agency'"
                                   context="{'default_is_company': True}"
                                   domain="[('is_company', '=', True)]"/>
                        </group>
                        <group string="Liên hệ và quản lý">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active"/>
                            <field name="current_rate" class="edu_metric" groups="edu_gvnn.group_edu_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử đơn giá" groups="edu_gvnn.group_edu_manager">
                            <field name="rate_ids">
                                <tree editable="bottom">
                                    <field name="date_from"/>
                                    <field name="rate"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_edu_teacher_search" model="ir.ui.view">
        <field name="name">edu.teacher.search</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="agency" string="Qua Agency" domain="[('teacher_type', '=', 'agency')]"/>
                <filter name="direct" string="Làm trực tiếp" domain="[('teacher_type', '=', 'direct')]"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_type" string="Loại giáo viên" context="{'group_by': 'teacher_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_teacher" model="ir.actions.act_window">
        <field name="name">Giáo viên</field>
        <field name="res_model">edu.teacher</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
