<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_class_tree" model="ir.ui.view">
        <field name="name">edu.class.tree</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <tree class="edu_list">
                <field name="name"/>
                <field name="zalo_group"/>
                <field name="teacher_ids" widget="many2many_tags"/>
                <field name="student_count"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_class_form" model="ir.ui.view">
        <field name="name">edu.class.form</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="edu_profile_heading">
                        <span class="edu_profile_icon fa fa-users" aria-hidden="true"/>
                        <div class="oe_title"><div class="edu_eyebrow">LỚP HỌC</div><h1><field name="name" placeholder="Tên lớp học"/></h1></div>
                    </div>
                    <group>
                        <group string="Thông tin lớp">
                            <field name="zalo_group"/>
                        </group>
                        <group string="Phân công giảng dạy">
                            <field name="teacher_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Học viên">
                            <field name="student_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'studying'" decoration-muted="state == 'stopped'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_class_search" model="ir.ui.view">
        <field name="name">edu.class.search</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="zalo_group"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_edu_class" model="ir.actions.act_window">
        <field name="name">Lớp</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
