<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_tuition_payment_tree" model="ir.ui.view">
        <field name="name">edu.tuition.payment.tree</field>
        <field name="model">edu.tuition.payment</field>
        <field name="arch" type="xml">
            <tree decoration-danger="payment_type == 'refund'">
                <field name="ref"/>
                <field name="date"/>
                <field name="student_id"/>
                <field name="payment_type"/>
                <field name="blocks"/>
                <field name="gross_amount" optional="hide"/>
                <field name="discount_amount" optional="hide"/>
                <field name="amount" sum="Tổng"/>
                <field name="method"/>
                <field name="user_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_tuition_payment_form" model="ir.ui.view">
        <field name="name">edu.tuition.payment.form</field>
        <field name="model">edu.tuition.payment</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <header>
                    <button name="%(action_report_edu_tuition_receipt)d" type="action"
                            string="In phiếu" class="btn-primary" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="ref"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type" groups="edu_gvnn.group_edu_manager"/>
                            <field name="student_id"/>
                            <field name="date"/>
                            <field name="method"/>
                            <field name="payer_name"/>
                        </group>
                        <group>
                            <field name="blocks"/>
                            <field name="block_price"/>
                            <field name="gross_amount"/>
                            <field name="discount_amount"/>
                            <field name="amount"/>
                            <field name="amount_text"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                        <field name="user_id" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_edu_tuition_payment_search" model="ir.ui.view">
        <field name="name">edu.tuition.payment.search</field>
        <field name="model">edu.tuition.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref"/>
                <field name="student_id"/>
                <filter name="payment" string="Thu học phí" domain="[('payment_type', '=', 'payment')]"/>
                <filter name="refund" string="Hoàn tiền" domain="[('payment_type', '=', 'refund')]"/>
                <filter name="this_month" string="Tháng này"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_month" string="Tháng" context="{'group_by': 'date:month'}"/>
                    <filter name="group_student" string="Học viên" context="{'group_by': 'student_id'}"/>
                    <filter name="group_method" string="Hình thức" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_tuition_payment" model="ir.actions.act_window">
        <field name="name">Thu học phí</field>
        <field name="res_model">edu.tuition.payment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
