<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_import_wizard_form" model="ir.ui.view">
        <field name="name">edu.import.wizard.form</field>
        <field name="model">edu.import.wizard</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <p class="text-muted" invisible="result">
                    Chọn file Tổng hợp_GVNN.xlsx có sheet 2.ĐIỂM DANH.
                    Chế độ lịch sử chỉ nhập buổi học và bổ sung danh mục còn thiếu;
                    không nhập phiếu thu, số dư đầu kỳ, đơn giá hoặc kỳ lương.
                    Để trống khoảng ngày để lấy toàn bộ lịch sử.
                    Học viên mới mặc định Ngưng học; có thể chuyển sang Đang học sau khi kiểm tra.
                </p>
                <group invisible="result">
                    <group>
                        <field name="import_mode"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="date_from" required="import_mode == 'all'"/>
                        <field name="date_to"/>
                        <field name="agency_id"/>
                    </group>
                    <group string="Nội dung import" invisible="import_mode != 'all'">
                        <field name="import_catalog"/>
                        <field name="import_students"/>
                        <field name="set_opening"/>
                        <field name="import_payments"/>
                        <field name="import_sessions"/>
                        <field name="create_periods"/>
                    </group>
                </group>
                <group invisible="not result">
                    <field name="result" nolabel="1" colspan="2" widget="text"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="result"
                            confirm="Import có thể mất vài phút. Có thể chạy lại nhiều lần, dữ liệu đã import sẽ không bị trùng. Tiếp tục?"/>
                    <button string="Đóng" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edu_import_wizard" model="ir.actions.act_window">
        <field name="name">Nhập dữ liệu buổi học từ Excel</field>
        <field name="res_model">edu.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="menu_edu_import" model="ir.ui.menu">
        <field name="name">Nhập dữ liệu Excel</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
