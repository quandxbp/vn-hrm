<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_student_tree" model="ir.ui.view">
        <field name="name">edu.student.tree</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <tree class="edu_list" decoration-muted="state == 'stopped'">
                <field name="code"/>
                <field name="name"/>
                <field name="class_ids" widget="many2many_tags"/>
                <field name="zalo_group" optional="hide"/>
                <field name="parent_name" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="total_paid" optional="hide"/>
                <field name="learned_amount" optional="hide"/>
                <field name="balance"/>
                <field name="remaining_blocks"/>
                <field name="fee_warning" widget="badge" decoration-danger="fee_warning == 'out'" decoration-warning="fee_warning == 'low'"/>
                <field name="last_session_date" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'studying'" decoration-muted="state == 'stopped'"/>
            </tree>
        </field>
    </record>

    <record id="view_edu_student_form" model="ir.ui.view">
        <field name="name">edu.student.form</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <form class="edu_form">
                <header>
                    <button name="action_new_payment" type="object" string="Thu học phí"
                            class="btn-primary" invisible="not id"/>
                    <button name="action_stop" type="object" string="Ngưng học"
                            invisible="state != 'studying'"
                            confirm="Chuyển học viên sang trạng thái ngưng học?"/>
                    <button name="action_resume" type="object" string="Học lại" class="btn-primary"
                            invisible="state != 'stopped'"/>
                    <field name="state" widget="statusbar" statusbar_visible="studying,stopped"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="edu_profile_heading">
                        <span class="edu_profile_icon fa fa-graduation-cap" aria-hidden="true"/>
                        <div class="oe_title"><div class="edu_eyebrow">HỒ SƠ HỌC VIÊN</div><h1><field name="name_vi" placeholder="Tên học viên"/></h1></div>
                    </div>
                    <group>
                        <group string="Thông tin học tập">
                            <field name="code"/>
                            <field name="name_en"/>
                            <field name="class_ids" widget="many2many_tags"/>
                            <field name="zalo_group"/>
                        </group>
                        <group string="Liên hệ và quản lý">
                            <field name="parent_name"/>
                            <field name="phone" widget="phone"/>
                            <field name="opening_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Học phí">
                            <group>
                                <group string="Số dư học phí">
                                    <field name="opening_balance"/>
                                    <field name="total_paid"/>
                                    <field name="learned_amount"/>
                                    <field name="balance" class="edu_metric" decoration-danger="balance &lt; 0"/>
                                </group>
                                <group string="Tiến độ học tập">
                                    <field name="learned_hours"/>
                                    <field name="learned_blocks"/>
                                    <field name="remaining_blocks"/>
                                    <field name="fee_warning" widget="badge" decoration-danger="fee_warning == 'out'" decoration-warning="fee_warning == 'low'"/>
                                    <field name="last_session_date"/>
                                </group>
                            </group>
                            <field name="payment_ids" readonly="1">
                                <tree>
                                    <field name="ref"/>
                                    <field name="date"/>
                                    <field name="payment_type"/>
                                    <field name="blocks"/>
                                    <field name="amount" sum="Tổng"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Buổi đã học">
                            <field name="attendee_ids" readonly="1">
                                <tree decoration-muted="not present">
                                    <field name="date"/>
                                    <field name="teacher_id"/>
                                    <field name="present"/>
                                    <field name="blocks"/>
                                    <field name="charge_amount" sum="Tổng"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_edu_student_search" model="ir.ui.view">
        <field name="name">edu.student.search</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Học viên" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="class_ids"/>
                <filter name="studying" string="Đang học" domain="[('state', '=', 'studying')]"/>
                <filter name="stopped" string="Ngưng học" domain="[('state', '=', 'stopped')]"/>
                <separator/>
                <filter name="fee_out" string="Hết học phí" domain="[('fee_warning', '=', 'out')]"/>
                <filter name="fee_low" string="Gần hết học phí" domain="[('fee_warning', '=', 'low')]"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_state" string="Tình trạng" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_student" model="ir.actions.act_window">
        <field name="name">Học viên</field>
        <field name="res_model">edu.student</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_studying': 1}</field>
    </record>
</odoo>
