<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_edu_student" model="ir.sequence">
        <field name="name">Mã học viên</field>
        <field name="code">edu.student</field>
        <field name="prefix">HV</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_edu_tuition_payment" model="ir.sequence">
        <field name="name">Phiếu thu học phí</field>
        <field name="code">edu.tuition.payment</field>
        <field name="prefix">PT%(year)s-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_edu_tuition_refund" model="ir.sequence">
        <field name="name">Phiếu chi hoàn học phí</field>
        <field name="code">edu.tuition.refund</field>
        <field name="prefix">PC%(year)s-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
