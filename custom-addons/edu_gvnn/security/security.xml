<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_edu_gvnn" model="ir.module.category">
        <field name="name">Trung tâm GVNN</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_edu_staff" model="res.groups">
        <field name="name">Giáo vụ</field>
        <field name="category_id" ref="module_category_edu_gvnn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_edu_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="category_id" ref="module_category_edu_gvnn"/>
        <field name="implied_ids" eval="[(4, ref('group_edu_staff'))]"/>
    </record>

    <!-- Admin hệ thống luôn có quyền Quản lý -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_edu_manager'))]"/>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_edu_manager'))]"/>
    </record>
</odoo>
