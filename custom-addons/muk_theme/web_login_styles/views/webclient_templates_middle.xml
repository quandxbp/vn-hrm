<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Login layout middle template-->
    <template id="web_login_styles.login_template_middle" name="Login">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="title">Đăng nhập hệ thống</t>

            <div class="background" t-attf-style="background-image: url('#{bg_img}');
                    background-color: #{color};
                    height: 100%;background-repeat:
                    no-repeat; background-size: cover;">
                <div class="container py-5">
                    <div t-attf-class="card mx-auto bg-100 {{login_card_classes}} o_database_list p-3 mt-5"
                         style="max-width: 400px; box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px !important; border-radius: 25px !important;">
                        <div class="card-body">
                            <div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
                                <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo"
                                     style="max-height:120px; max-width: 100%; width:auto"/>
                                <h4 class="bold-text text-primary text-center mt-3">HỆ THỐNG QUẢN TRỊ NGUỒN NHÂN LỰC DOANH NGHIỆP</h4>
                            </div>
                            <t t-out="0"/>

                            <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post"
                                  onsubmit="this.action = '/web/login' + location.hash">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mt-2 mb-2">
                                    <p class="alert alert-danger" t-if="error" role="alert">
                                        <t t-esc="error"/>
                                    </p>
                                    <p class="alert alert-success" t-if="message" role="status">
                                        <t t-esc="message"/>
                                    </p>
                                </div>

                                <div class="form-group field-db"
                                     t-if="databases and len(databases) &gt; 1">
                                    <label for="db" class="col-form-label">
                                        Cơ sở dữ liệu
                                    </label>
                                    <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                                        <input type="text" name="db" t-att-value="request.db"
                                               t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                               required="required"
                                               readonly="readonly"/>
                                        <span class="input-group-append">
                                            <a role="button"
                                               href="/web/database/selector"
                                               class="btn btn-secondary">Chọn
                                                <i class="fa fa-database"
                                                   role="img"
                                                   aria-label="Database"
                                                   title="Database"/>
                                            </a>
                                        </span>
                                    </div>
                                </div>

                                <div class="form-group field-login mt-2">
                                    <label for="login">Tên đăng nhập</label>
                                    <input type="text"
                                           name="login"
                                           placeholder="Đăng nhập ..."
                                           t-att-value="login" id="login"
                                           t-attf-class="mt-2 form-control #{'form-control-sm' if form_small else ''}"
                                           required="required"
                                           autofocus="autofocus"
                                           autocapitalize="off"/>
                                </div>
                                <div class="form-group field-password mt-3">
                                    <label for="password">Mật khẩu</label>
                                    <input type="password"
                                           placeholder="Mật khẩu ..."
                                           name="password"
                                           id="password"
                                           t-attf-class="mt-2 form-control #{'form-control-sm' if form_small else ''}"
                                           required="required"
                                           autocomplete="current-password"
                                           t-att-autofocus="'autofocus' if login else None"
                                           maxlength="4096"/>
                                </div>

                                <div class="border-top" />
                                <div t-attf-class="clearfix oe_login_buttons text-center mb-1 {{'pt-2 pb-2' if form_small else 'pt-4 pb-4'}}">
                                    <button type="submit" class="btn btn-primary btn-block w-100 mt-3">ĐĂNG NHẬP</button>
                                    <t t-if="debug">
                                        <button type="submit" name="redirect" value="/web/become"
                                                class="btn btn-link btn-sm btn-block mt-4">
                                            Đăng nhập dưới quyền Administrator
                                        </button>
                                    </t>
                                    <div class="o_login_auth"/>
                                </div>
                                <input type="hidden" name="redirect" t-att-value="redirect"/>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
