<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_registration_tree" model="ir.ui.view">
        <field name="name">crm.lead.website.registration.tree</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <tree string="Đăng ký từ website" create="false" default_order="create_date desc">
                <field name="create_date" string="Thời gian đăng ký"/>
                <field name="contact_name" string="Họ và tên"/>
                <field name="phone" string="Số điện thoại" widget="phone"/>
                <field name="email_from" string="Email" widget="email"/>
                <field name="edu_program_interest"/>
                <field name="stage_id" string="Trạng thái tư vấn"/>
                <field name="user_id" string="Người phụ trách" widget="many2one_avatar_user"/>
                <field name="team_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>
    <record id="website_registration_form" model="ir.ui.view">
        <field name="name">crm.lead.website.registration.form</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Đăng ký tư vấn từ website" create="false">
                <header><field name="stage_id" widget="statusbar" options="{'clickable': True}"/></header>
                <sheet>
                    <field name="active" invisible="True"/>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-warning" invisible="active"/>
                    <div class="oe_title"><span class="text-muted">Đăng ký tư vấn từ website</span><h1><field name="contact_name" placeholder="Họ và tên người đăng ký"/></h1></div>
                    <group string="Thông tin đăng ký" name="registration_details">
                        <group><field name="phone" string="Số điện thoại" widget="phone"/><field name="email_from" string="Email" widget="email"/></group>
                        <group><field name="edu_program_interest"/><field name="create_date" string="Thời gian đăng ký" readonly="True"/></group>
                    </group>
                    <group string="Theo dõi tư vấn">
                        <group><field name="user_id" string="Người phụ trách" widget="many2one_avatar_user"/><field name="team_id"/></group>
                        <group><field name="partner_id" string="Khách hàng liên kết"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <div class="mt-4">
                        <separator string="Nội dung và ghi chú"/>
                        <field name="description" widget="html" nolabel="1" class="w-100" placeholder="Ghi chú nhu cầu, lịch liên hệ và kết quả tư vấn…"/>
                    </div>
                    <field name="name" invisible="True"/>
                    <field name="type" invisible="True"/>
                    <field name="company_id" invisible="True" groups="!base.group_multi_company"/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="website_registration_search" model="ir.ui.view">
        <field name="name">crm.lead.website.registration.search</field>
        <field name="model">crm.lead</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Tìm đăng ký website">
                <field name="contact_name" string="Họ và tên"/>
                <field name="phone" string="Số điện thoại"/>
                <field name="email_from" string="Email"/>
                <field name="edu_program_interest"/>
                <field name="user_id" string="Người phụ trách"/>
                <filter name="unassigned" string="Chưa phân công" domain="[('user_id', '=', False)]"/>
                <filter name="my_registrations" string="Tôi phụ trách" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="registration_date" string="Thời gian đăng ký" date="create_date"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo"><filter name="by_program" string="Chương trình" context="{'group_by': 'edu_program_interest'}"/><filter name="by_stage" string="Trạng thái tư vấn" context="{'group_by': 'stage_id'}"/><filter name="by_assignee" string="Người phụ trách" context="{'group_by': 'user_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_website_registrations" model="ir.actions.act_window">
        <field name="name">Đăng ký từ website</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="website_registration_tree"/>
        <field name="search_view_id" ref="website_registration_search"/>
        <field name="domain">[('edu_website_registration', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Chưa có đăng ký từ website</p><p>Thông tin gửi từ form tư vấn sẽ xuất hiện tại đây.</p></field>
    </record>
    <record id="action_website_registrations_tree" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">tree</field><field name="view_id" ref="website_registration_tree"/><field name="act_window_id" ref="action_website_registrations"/></record>
    <record id="action_website_registrations_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="website_registration_form"/><field name="act_window_id" ref="action_website_registrations"/></record>
    <menuitem id="menu_website_registrations" name="Đăng ký từ website" parent="crm.crm_menu_root" action="action_website_registrations" sequence="7" groups="sales_team.group_sale_salesman"/>
    <function model="crm.lead" name="_migrate_website_registrations"/>
</odoo>
