<odoo>
    <record id="activity_tree" model="ir.ui.view">
        <field name="name">edu.landing.activity.tree</field>
        <field name="model">edu.landing.activity</field>
        <field name="arch" type="xml">
            <tree string="Hoạt động lớp học">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [80, 45]}"/>
                <field name="name"/>
                <field name="event_id"/>
                <field name="caption" optional="hide"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="is_published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="activity_form" model="ir.ui.view">
        <field name="name">edu.landing.activity.form</field>
        <field name="model">edu.landing.activity</field>
        <field name="arch" type="xml">
            <form string="Ảnh hoạt động lớp học">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Tên hoạt động"/></h1></div>
                    <group>
                        <group><field name="event_id"/><field name="is_published"/><field name="sequence"/><field name="website_id" groups="website.group_multi_website"/></group>
                        <group><field name="alt_text"/><field name="caption" placeholder="Chú thích ngắn bên dưới ảnh"/></group>
                    </group>
                    <field name="image_1920" widget="image" options="{'preview_image': 'image_1920', 'size': [960, 540]}"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="activity_search" model="ir.ui.view">
        <field name="name">edu.landing.activity.search</field>
        <field name="model">edu.landing.activity</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="event_id"/><filter name="published" string="Highlight" domain="[('is_published', '=', True)]"/><filter name="unpublished" string="Ảnh lưu trữ" domain="[('is_published', '=', False)]"/><group string="Nhóm theo"><filter name="group_event" string="Sự kiện" context="{'group_by': 'event_id'}"/></group></search></field>
    </record>

    <record id="activity_event_tree" model="ir.ui.view">
        <field name="name">edu.landing.activity.event.tree</field>
        <field name="model">edu.landing.activity.event</field>
        <field name="arch" type="xml">
            <tree string="Sự kiện hoạt động lớp học"><field name="name"/><field name="date"/><field name="image_count"/><field name="highlight_count"/><field name="active" optional="hide"/></tree>
        </field>
    </record>
    <record id="activity_event_form" model="ir.ui.view">
        <field name="name">edu.landing.activity.event.form</field>
        <field name="model">edu.landing.activity.event</field>
        <field name="arch" type="xml">
            <form string="Sự kiện hoạt động lớp học">
                <header><button name="action_upload_images" type="object" string="Tải nhiều ảnh" class="oe_highlight"/></header>
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-warning" invisible="active"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ví dụ: Sự kiện 20/10"/></h1></div>
                    <group><group><field name="date"/><field name="active" invisible="1"/></group><group><field name="image_count"/><field name="highlight_count"/></group></group>
                    <field name="description" placeholder="Ghi chú về sự kiện"/>
                    <separator string="Ảnh trong sự kiện"/>
                    <p class="text-muted">Chọn Highlight cho những ảnh muốn đưa lên slideshow trang chủ. Những ảnh còn lại được lưu trong sự kiện.</p>
                    <field name="image_ids" context="{'default_event_id': id}">
                        <tree editable="bottom">
                            <control><create string="Thêm một ảnh"/></control>
                            <field name="sequence" widget="handle"/>
                            <field name="image_1920" widget="image" options="{'size': [120, 68]}"/>
                            <field name="name"/>
                            <field name="caption" optional="hide"/>
                            <field name="is_published"/>
                            <field name="website_id" optional="hide" groups="website.group_multi_website"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="activity_event_search" model="ir.ui.view">
        <field name="name">edu.landing.activity.event.search</field>
        <field name="model">edu.landing.activity.event</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="date"/><filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/><group string="Nhóm theo"><filter name="month" string="Tháng" context="{'group_by': 'date:month'}"/></group></search></field>
    </record>
    <record id="activity_upload_form" model="ir.ui.view">
        <field name="name">edu.landing.activity.upload.form</field>
        <field name="model">edu.landing.activity.upload</field>
        <field name="arch" type="xml">
            <form string="Tải ảnh sự kiện">
                <group><field name="event_id" readonly="1"/><field name="attachment_ids" widget="many2many_binary" options="{'accepted_file_extensions': 'image/*'}"/></group>
                <p class="text-muted">Có thể chọn nhiều ảnh cùng lúc. Ảnh tải lên được lưu trong sự kiện; chọn Highlight sau khi tải để đưa ảnh lên trang chủ.</p>
                <footer><button name="action_upload" type="object" string="Thêm vào sự kiện" class="btn-primary"/><button string="Huỷ" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="activity_action" model="ir.actions.act_window">
        <field name="name">Hoạt động lớp học</field>
        <field name="res_model">edu.landing.activity.event</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Tạo sự kiện hoạt động lớp học</p><p>Tải ảnh vào từng sự kiện và chọn Highlight cho những ảnh muốn hiển thị trên trang chủ.</p></field>
    </record>
    <menuitem id="menu_landing_activities" name="Hoạt động lớp học" parent="menu_kim_website" action="activity_action" sequence="20" groups="website.group_website_designer"/>
</odoo>
