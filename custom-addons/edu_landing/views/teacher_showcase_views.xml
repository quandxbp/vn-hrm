<odoo>
    <record id="teacher_showcase_tree" model="ir.ui.view">
        <field name="name">edu.landing.teacher.tree</field>
        <field name="model">edu.landing.teacher</field>
        <field name="arch" type="xml">
            <tree string="Giáo viên website">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [60, 80]}"/>
                <field name="name"/><field name="team"/><field name="position"/><field name="certification"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="is_published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="teacher_showcase_form" model="ir.ui.view">
        <field name="name">edu.landing.teacher.form</field>
        <field name="model">edu.landing.teacher</field>
        <field name="arch" type="xml">
            <form string="Giáo viên website">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Họ và tên giáo viên"/></h1></div>
                    <group>
                        <group>
                            <field name="team"/><field name="position"/><field name="certification"/>
                            <field name="is_published"/><field name="sequence"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                        <group><field name="image_1920" widget="image" nolabel="1" options="{'size': [300, 400]}"/><field name="alt_text"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="teacher_showcase_search" model="ir.ui.view">
        <field name="name">edu.landing.teacher.search</field>
        <field name="model">edu.landing.teacher</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="position"/><field name="certification"/><field name="team"/>
                <filter name="published" string="Đang hiển thị" domain="[('is_published', '=', True)]"/>
                <filter name="unpublished" string="Đang ẩn" domain="[('is_published', '=', False)]"/>
                <group string="Nhóm theo"><filter name="team_group" string="Nhóm giáo viên" context="{'group_by': 'team'}"/></group>
            </search>
        </field>
    </record>
    <record id="teacher_showcase_action" model="ir.actions.act_window">
        <field name="name">Giáo viên</field>
        <field name="res_model">edu.landing.teacher</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Thêm giáo viên lên website</p><p>Tải ảnh, nhập thông tin, chọn nhóm và bật hiển thị. Kéo thả để sắp xếp thứ tự.</p></field>
    </record>
    <menuitem id="menu_landing_teachers" name="Giáo viên" parent="menu_kim_website" action="teacher_showcase_action" sequence="40" groups="website.group_website_designer"/>

    <template id="teacher_showcase_card" name="Thẻ giáo viên website">
        <article class="edu-smem-item">
            <img t-att-src="'/web/image/edu.landing.teacher/%s/image_1920' % teacher.id" t-att-alt="teacher.alt_text or teacher.name" loading="lazy"/>
            <div class="edu-smem-body">
                <span t-if="teacher.position" class="edu-smem-pos" t-field="teacher.position"/>
                <h3 class="edu-display" t-field="teacher.name"/>
                <span t-if="teacher.certification" class="edu-smem-cert" t-field="teacher.certification"/>
            </div>
        </article>
    </template>
</odoo>
