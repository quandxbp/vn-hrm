<odoo>
    <record id="course_tree" model="ir.ui.view">
        <field name="name">edu.landing.course.tree</field>
        <field name="model">edu.landing.course</field>
        <field name="arch" type="xml"><tree><field name="sequence" widget="handle"/><field name="name"/><field name="age_range"/><field name="seats_confirmed"/><field name="seats_remaining"/><field name="is_published"/></tree></field>
    </record>
    <record id="course_form" model="ir.ui.view">
        <field name="name">edu.landing.course.form</field>
        <field name="model">edu.landing.course</field>
        <field name="arch" type="xml">
            <form string="Khóa học website">
                <header><button name="action_open_website" type="object" string="Xem trên website" class="oe_highlight" invisible="not is_published"/></header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Tên khóa học"/></h1></div>
                    <group><group><field name="slug"/><field name="age_range"/><field name="target"/><field name="program_value"/></group><group><field name="is_published"/><field name="website_id" groups="website.group_multi_website"/><field name="seats_confirmed"/><field name="seats_remaining" invisible="not seats_confirmed"/><field name="sequence"/></group></group>
                    <div class="alert alert-info" role="status">Chưa bật “Đã cập nhật số lượng còn nhận”: website hiển thị “Đang cập nhật”. Khi bật và số lượng bằng 0: hiển thị “Đã đủ số lượng đợt này”. Số lượng được cập nhật thủ công, không tự giảm khi gửi tư vấn.</div>
                    <notebook><page string="Giới thiệu"><field name="introduction" placeholder="Giới thiệu ngắn về khóa học"/><field name="description" widget="html"/></page><page string="Ảnh mặc định"><field name="fallback_image"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="course_action" model="ir.actions.act_window"><field name="name">Khóa học</field><field name="res_model">edu.landing.course</field><field name="view_mode">tree,form</field></record>
    <menuitem id="menu_landing_courses" name="Khóa học" parent="menu_kim_website" action="course_action" sequence="10" groups="website.group_website_designer"/>
</odoo>
