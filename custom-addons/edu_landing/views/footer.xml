<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Chân trang. priority=30 để chạy sau footer mặc định (footer_custom, priority 16). -->
    <template id="footer" inherit_id="website.layout" name="Chân trang trung tâm Anh ngữ" priority="30">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo edu-footer" t-ignore="true" t-if="not no_footer">
                <section class="edu-footer-main" id="lien-he">
                    <div class="container">
                        <div class="edu-footer-invite">
                            <div>
                                <span class="edu-footer-eyebrow">Cùng con tự tin hơn mỗi ngày</span>
                                <h2 class="edu-display">Bắt đầu hành trình tiếng Anh cùng Kim</h2>
                                <p>Để lại thông tin để được tư vấn lộ trình học phù hợp.</p>
                            </div>
                            <a href="/#dang-ky" class="btn edu-btn edu-btn-accent">Nhận tư vấn miễn phí <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                        </div>
                        <div class="row g-4 g-xl-5 edu-footer-columns">
                            <div class="col-lg-4">
                                <a href="/" class="edu-footer-brand" aria-label="Kim Academy — Trang chủ">Kim Academy<span>Language Center</span></a>
                                <!-- Ảnh trên trang là ảnh minh hoạ từ Facebook Kim Academy, xem static/src/img/kim/SOURCES.json. -->
                                <p class="edu-footer-description">Lộ trình học tiếng Anh từ Mầm non đến THPT, chuẩn CEFR. Đồng hành cùng học viên xây dựng nền tảng vững chắc và sự tự tin với tiếng Anh.</p>
                                <a href="/gioi-thieu" class="edu-footer-story">Khám phá Kim Academy <i class="fa fa-long-arrow-right" aria-hidden="true"/></a>
                            </div>
                            <div class="col-6 col-lg-2">
                                <h5>Chương trình</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/#chuong-trinh">Tiếng Anh mầm non</a></li>
                                    <li><a href="/#chuong-trinh">Tiếng Anh tiểu học</a></li>
                                    <li><a href="/#chuong-trinh">Tiếng Anh thiếu niên</a></li>
                                    <li><a href="/#chuong-trinh">IELTS và SAT</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-lg-2">
                                <h5>Về chúng tôi</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/gioi-thieu">Giới thiệu</a></li>
                                    <li><a href="/tuyen-dung">Tuyển dụng</a></li>
                                    <li><a href="/#giao-vien">Đội ngũ giáo viên</a></li>
                                    <li><a href="/#thanh-tich">Thành tích</a></li>
                                    <li><a href="/lien-he">Liên hệ</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4">
                                <h5>Kết nối với chúng tôi</h5>
                                <ul class="list-unstyled edu-footer-contact">
                                    <li>
                                        <i class="fa fa-map-marker" aria-hidden="true"/>
                                        <div>
                                            <span>Địa chỉ trung tâm</span>
                                            <t t-call="edu_landing.directions_link"><t t-set="map_link_label">257 Lý Thường Kiệt, KP Tân Phú 2, P. Bình Phước, TP. Đồng Nai</t></t>
                                            <t t-call="edu_landing.directions_link"><t t-set="map_link_class">edu-footer-directions</t><t t-set="map_link_icon" t-value="True"/></t>
                                        </div>
                                    </li>
                                    <li><i class="fa fa-phone" aria-hidden="true"/><div><span>Hotline tư vấn</span><a href="tel:0766777793" class="edu-footer-phone">0766.7777.93</a></div></li>
                                    <li><i class="fa fa-envelope-o" aria-hidden="true"/><div><span>Email</span><a href="mailto:kimacademy.edu@gmail.com">kimacademy.edu@gmail.com</a></div></li>
                                </ul>
                            </div>
                        </div>
                        <div class="edu-footer-bottom">
                            <p>© Kim Academy <span>·</span> Nuôi dưỡng niềm yêu thích tiếng Anh</p>
                            <div class="edu-footer-social">
                                <span>Theo dõi Kim</span>
                                <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                                    <h5 class="s_social_media_title d-none" contenteditable="true">Theo dõi chúng tôi</h5>
                                    <a href="https://www.facebook.com/mskim.kimacademy" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                        <i class="fa fa-facebook o_editable_media"/>
                                    </a>
                                    <a href="https://www.youtube.com/@YURYONG90" class="s_social_media_youtube" target="_blank" aria-label="YouTube">
                                        <i class="fa fa-youtube-play o_editable_media"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace"/>
    </template>

</odoo>
