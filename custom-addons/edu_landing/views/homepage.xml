<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Trang chủ trung tâm Anh ngữ.
        Thông tin THẬT của trung tâm: tên Kim Academy Language Center, hotline, chứng nhận MTS UK và
        Cambridge, lộ trình CEFR (khối #uy-tin). Phần còn lại vẫn là MẪU: số liệu, giáo viên, học viên,
        lời cảm nhận, địa chỉ, email.
        Ảnh đã tuyển chọn từ Facebook Kim Academy; nguồn trong static/src/img/kim/SOURCES.json.
        Các số liệu marketing và lời cảm nhận mẫu vẫn cần trung tâm xác nhận trước khi công bố.
        Các khối nằm trong vùng oe_structure nên vẫn sửa được bằng trình dựng kéo thả của Website.
    -->
    <template id="homepage" inherit_id="website.homepage" name="Trang chủ trung tâm Anh ngữ">
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-set="title">Kim Academy | Trung tâm Anh ngữ</t>
            <t t-set="img" t-value="'/edu_landing/static/src/img/'"/>
            <div id="wrap" class="oe_structure edu-landing edu-home">

                <!-- ============ HERO ============ -->
                <section class="edu-hero" id="gioi-thieu" aria-labelledby="edu-hero-heading">
                    <img class="edu-hero-img" t-att-src="img + 'kim/recognition.jpg'" alt="" fetchpriority="high"/>
                    <div class="edu-hero-scene" aria-hidden="true">
                        <div class="edu-hero-globe">
                            <svg viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <radialGradient id="edu-globe-fill" cx="0.33" cy="0.2" r="0.85">
                                        <stop stop-color="#b9d9f1"/><stop offset="0.48" stop-color="#5c91c6"/><stop offset="1" stop-color="#173d70"/>
                                    </radialGradient>
                                    <clipPath id="edu-globe-clip"><circle cx="400" cy="400" r="370"/></clipPath>
                                </defs>
                                <circle cx="400" cy="400" r="370" fill="url(#edu-globe-fill)"/>
                                <g clip-path="url(#edu-globe-clip)" stroke="#e4f4ff" stroke-opacity="0.25" stroke-width="1.3">
                                    <ellipse cx="400" cy="400" rx="260" ry="370"/><ellipse cx="400" cy="400" rx="130" ry="370"/>
                                    <ellipse cx="400" cy="400" rx="370" ry="130"/><ellipse cx="400" cy="400" rx="370" ry="260"/>
                                    <path d="M30 400H770M400 30V770"/>
                                    <g fill="#d2ecf5" fill-opacity="0.24" stroke="none">
                                        <path d="M144 173L220 122 293 139 321 184 284 225 298 267 249 302 228 365 187 333 182 281 128 253Z"/>
                                        <path d="M245 377L308 394 341 447 318 509 285 551 265 620 235 571 229 498 204 444Z"/>
                                        <path d="M413 175L477 147 536 165 574 148 656 194 694 250 657 283 590 267 560 312 513 289 480 316 442 285 399 255Z"/>
                                        <path d="M438 316L501 321 542 370 520 431 479 489 449 468 431 413 402 368Z"/>
                                        <path d="M588 489L644 470 683 504 670 549 609 557 576 527Z"/>
                                    </g>
                                </g>
                                <path class="edu-globe-route" d="M145 430C230 235 365 558 470 337S634 252 685 370" stroke="#f5be72" stroke-width="4" stroke-linecap="round" stroke-dasharray="8 12"/>
                                <g fill="#fff" stroke="#f5be72" stroke-width="7"><circle cx="145" cy="430" r="10"/><circle cx="470" cy="337" r="10"/><circle cx="685" cy="370" r="10"/></g>
                            </svg>
                        </div>
                        <span class="edu-hero-float edu-hero-float-book"><i class="fa fa-book"/></span>
                        <span class="edu-hero-float edu-hero-float-cap"><i class="fa fa-graduation-cap"/></span>
                        <span class="edu-hero-spark edu-hero-spark-one">✦</span>
                        <span class="edu-hero-spark edu-hero-spark-two">✧</span>
                    </div>
                    <div class="container edu-hero-content">
                        <span class="edu-hero-kicker"><i class="fa fa-star-o" aria-hidden="true"/> Dẫn lối nhân tài</span>
                        <h1 class="edu-display edu-hero-title" id="edu-hero-heading"><span>Ươm mầm</span> <em>tài năng</em></h1>
                        <p class="edu-hero-sub">
                            Nền tảng học thuật tiếng Anh vững chắc, nuôi dưỡng sự tò mò và khát vọng lớn
                            cho học viên từ 3 tuổi.
                        </p>
                        <div class="edu-hero-actions">
                            <a href="#dang-ky" class="btn edu-btn edu-btn-sec">Nhận tư vấn miễn phí <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                            <a href="/gioi-thieu" class="btn edu-btn edu-btn-outline-light">Câu chuyện của chúng tôi <i class="fa fa-arrow-up" aria-hidden="true"/></a>
                        </div>
                    </div>

                    <!-- Tìm khoá học theo độ tuổi -->
                    <div class="container edu-finder-wrap">
                        <div class="edu-finder">
                            <div class="edu-finder-label">
                                <i class="fa fa-search" role="img" aria-label=""/>
                                <span>Tìm khoá học theo độ tuổi</span>
                            </div>
                            <div class="edu-chips" role="group" aria-label="Chọn độ tuổi">
                                <button type="button" class="edu-chip" data-age="3-5" aria-pressed="false">3 - 5 tuổi</button>
                                <button type="button" class="edu-chip" data-age="6-10" aria-pressed="false">6 - 10 tuổi</button>
                                <button type="button" class="edu-chip" data-age="11-14" aria-pressed="false">11 - 14 tuổi</button>
                                <button type="button" class="edu-chip" data-age="15-18" aria-pressed="false">15 - 18 tuổi</button>
                                <button type="button" class="edu-chip" data-age="19-21" aria-pressed="false">19 - 21+ tuổi</button>
                            </div>
                            <a href="#chuong-trinh" class="btn edu-btn edu-btn-pri edu-finder-go">Tìm khoá học <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                        </div>
                    </div>
                    <a class="edu-hero-scroll" href="#uy-tin" aria-label="Khám phá Kim Academy"><span/><i class="fa fa-angle-down" aria-hidden="true"/></a>
                </section>

                <!-- ============ UY TÍN + LỘ TRÌNH CEFR ============ -->
                <section class="edu-cred" id="uy-tin">
                    <div class="container">
                        <header class="edu-head">
                            <span class="edu-head-sub">Kim Academy Language Center</span>
                            <h2 class="edu-display">Uy tín được công nhận</h2>
                        </header>
                        <div class="row g-3 g-lg-4 justify-content-center">
                            <div class="col-md-6">
                                <div class="edu-cred-item">
                                    <span class="edu-cred-icon"><i class="fa fa-certificate" role="img" aria-label=""/></span>
                                    <p>Thành viên chính thức của Cơ quan khảo thí MTS UK</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="edu-cred-item">
                                    <span class="edu-cred-icon"><i class="fa fa-graduation-cap" role="img" aria-label=""/></span>
                                    <p>Trung tâm đạt chuẩn Exam Preparation Center do Cambridge công nhận</p>
                                </div>
                            </div>
                        </div>
                        <div class="edu-path">
                            <p class="edu-path-lead">
                                Lộ trình học tiếng Anh tại KIM ACADEMY từ Mầm non đến THPT, chuẩn CEFR
                            </p>
                            <ol class="edu-path-list">
                                <li>Starters</li>
                                <li>Movers</li>
                                <li>Flyers</li>
                                <li>KET</li>
                                <li>PET</li>
                                <li class="is-goal">IELTS 6.5+</li>
                            </ol>
                        </div>
                    </div>
                </section>

                <!-- ============ SỐ LIỆU (nền gradient xanh) ============ -->
                <section class="edu-snum" id="thanh-tich">
                    <div class="container">
                        <header class="edu-head edu-head-light">
                            <span class="edu-head-sub">15 năm</span>
                            <h2 class="edu-display">Một khát vọng</h2>
                        </header>
                        <div class="edu-snum-hl">
                            <strong class="edu-display edu-count" data-target="1500" data-suffix=" tỷ+">1.500 tỷ+</strong>
                            <span>học bổng từ các đại học top 100 thế giới</span>
                        </div>
                        <div class="row g-4 edu-snum-row">
                            <div class="col-6 col-lg">
                                <div class="edu-snum-item">
                                    <i class="fa fa-university" role="img" aria-label=""/>
                                    <strong class="edu-display edu-count" data-target="50000" data-suffix="+">50.000+</strong>
                                    <span>học viên đạt điểm đầu vào đại học</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="edu-snum-item">
                                    <i class="fa fa-certificate" role="img" aria-label=""/>
                                    <strong class="edu-display edu-count" data-target="90" data-suffix="%">90%</strong>
                                    <span>đạt mục tiêu Cambridge</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="edu-snum-item">
                                    <i class="fa fa-trophy" role="img" aria-label=""/>
                                    <strong class="edu-display edu-count" data-target="12000" data-suffix="+">12.000+</strong>
                                    <span>học viên IELTS 6.0+</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="edu-snum-item">
                                    <i class="fa fa-star" role="img" aria-label=""/>
                                    <strong class="edu-display edu-count" data-target="8000" data-suffix="+">8.000+</strong>
                                    <span>học viên IELTS 6.5+</span>
                                </div>
                            </div>
                            <div class="col-12 col-lg">
                                <div class="edu-snum-item">
                                    <i class="fa fa-rocket" role="img" aria-label=""/>
                                    <strong class="edu-display edu-count" data-target="4000" data-suffix="+">4.000+</strong>
                                    <span>học viên IELTS 7.0+</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ CHƯƠNG TRÌNH (thẻ ảnh đứng) ============ -->
                <section class="edu-course" id="chuong-trinh">
                    <div class="container">
                        <header class="edu-head">
                            <span class="edu-head-sub">Giáo dục chất lượng</span>
                            <h2 class="edu-display">Cho mọi lứa tuổi</h2>
                        </header>
                        <div class="row g-3 g-lg-4">
                            <div class="col-12 col-md-6 col-xl-3">
                                <a href="/khoa-hoc/tieng-anh-mam-non" class="edu-course-item" data-ages="3-5" data-level="Tiếng Anh mầm non">
                                    <img t-att-src="img + 'kim/learning-materials.jpg'" alt="" loading="lazy"/>
                                    <div class="edu-course-body">
                                        <span class="edu-course-tag">3 - 5 tuổi</span>
                                        <h3 class="edu-display">Mầm non</h3>
                                        <p>Làm quen tiếng Anh qua trò chơi, khoa học và sáng tạo.</p>
                                        <span class="edu-course-target">Mục tiêu: Pre-Starters</span>
                                        <span class="edu-course-more">Xem chi tiết <i class="fa fa-arrow-right" role="img" aria-label=""/></span>
                                    </div>
                                </a>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <a href="/khoa-hoc/tieng-anh-tieu-hoc" class="edu-course-item" data-ages="6-10" data-level="Tiếng Anh tiểu học">
                                    <img t-att-src="img + 'kim/classroom-boards.jpg'" alt="" loading="lazy"/>
                                    <div class="edu-course-body">
                                        <span class="edu-course-tag">6 - 10 tuổi</span>
                                        <h3 class="edu-display">Tiểu học</h3>
                                        <p>Giáo viên bản ngữ, học theo dự án, lộ trình chuẩn Cambridge.</p>
                                        <span class="edu-course-target">Mục tiêu: Cambridge Flyers</span>
                                        <span class="edu-course-more">Xem chi tiết <i class="fa fa-arrow-right" role="img" aria-label=""/></span>
                                    </div>
                                </a>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <a href="/khoa-hoc/tieng-anh-thieu-nien" class="edu-course-item" data-ages="11-14" data-level="Tiếng Anh thiếu niên">
                                    <img t-att-src="img + 'kim/classroom-speaking.jpg'" alt="" loading="lazy"/>
                                    <div class="edu-course-body">
                                        <span class="edu-course-tag">11 - 14 tuổi</span>
                                        <h3 class="edu-display">Thiếu niên</h3>
                                        <p>Tư duy phản biện, kỹ năng thuyết trình và nghiên cứu.</p>
                                        <span class="edu-course-target">Mục tiêu: IELTS 5.5+</span>
                                        <span class="edu-course-more">Xem chi tiết <i class="fa fa-arrow-right" role="img" aria-label=""/></span>
                                    </div>
                                </a>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <a href="/khoa-hoc/ielts-sat" class="edu-course-item" data-ages="15-18 19-21" data-level="IELTS / SAT">
                                    <img t-att-src="img + 'kim/study-together.jpg'" alt="" loading="lazy"/>
                                    <div class="edu-course-body">
                                        <span class="edu-course-tag">15 tuổi trở lên</span>
                                        <h3 class="edu-display">IELTS - SAT</h3>
                                        <p>Chiến lược đạt band mục tiêu, tư duy học thuật cho du học.</p>
                                        <span class="edu-course-target">Mục tiêu: IELTS 7.0+ · SAT 1250+</span>
                                        <span class="edu-course-more">Xem chi tiết <i class="fa fa-arrow-right" role="img" aria-label=""/></span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ GIÁO VIÊN ============ -->
                <section class="edu-smem" id="giao-vien">
                    <div class="container">
                        <t t-set="teachers" t-value="website._get_landing_teachers()"/>
                        <t t-set="center_teachers" t-value="teachers.filtered(lambda teacher: teacher.team == 'center')"/>
                        <t t-set="international_teachers" t-value="teachers.filtered(lambda teacher: teacher.team == 'international')"/>
                        <div class="edu-smem-head">
                            <header class="edu-head edu-head-left">
                                <span class="edu-head-sub">Đội ngũ</span>
                                <h2 class="edu-display">Giáo viên xuất sắc</h2>
                            </header>
                            <ul class="edu-smem-badges">
                                <li><i class="fa fa-check-circle" aria-hidden="true"/> Tận tâm trong từng bài học</li>
                                <li><i class="fa fa-check-circle" aria-hidden="true"/> Đồng hành cùng sự tiến bộ của học viên</li>
                            </ul>
                        </div>
                        <div class="edu-smem-tabs" role="tablist" aria-label="Chọn đội ngũ giáo viên">
                            <button type="button" id="edu-teachers-center-tab" class="edu-smem-tab is-active" role="tab" aria-selected="true" aria-controls="edu-teachers-center" data-team="center"><i class="fa fa-building-o" aria-hidden="true"/> Giáo viên tại trung tâm</button>
                            <button type="button" id="edu-teachers-international-tab" class="edu-smem-tab" role="tab" aria-selected="false" aria-controls="edu-teachers-international" tabindex="-1" data-team="international"><i class="fa fa-globe" aria-hidden="true"/> Giáo viên nước ngoài</button>
                        </div>
                        <div class="edu-smem-panel" id="edu-teachers-center" role="tabpanel" aria-labelledby="edu-teachers-center-tab" data-team="center" tabindex="0">
                            <p class="edu-smem-team-intro">Đội ngũ giảng dạy và đào tạo tại Kim Academy.</p>
                            <div class="row g-3 g-lg-4 justify-content-center">
                                <div t-foreach="center_teachers" t-as="teacher" class="col-12 col-md-6">
                                    <t t-call="edu_landing.teacher_showcase_card"/>
                                </div>
                            </div>
                            <p t-if="not center_teachers" class="text-center text-muted">Thông tin giáo viên tại trung tâm đang được cập nhật.</p>
                        </div>
                        <div class="edu-smem-panel" id="edu-teachers-international" role="tabpanel" aria-labelledby="edu-teachers-international-tab" data-team="international" tabindex="0" hidden="hidden">
                            <p class="edu-smem-team-intro">Khám phá đội ngũ giáo viên nước ngoài đồng hành cùng Kim Academy.</p>
                            <div class="row g-3 g-lg-4 justify-content-center">
                                <div t-foreach="international_teachers" t-as="teacher" class="col-12 col-md-6">
                                    <t t-call="edu_landing.teacher_showcase_card"/>
                                </div>
                            </div>
                            <p t-if="not international_teachers" class="text-center text-muted">Thông tin giáo viên nước ngoài đang được cập nhật.</p>
                        </div>
                    </div>
                </section>

                <!-- ============ GIÁO TRÌNH (băng chạy) ============ -->
                <section class="edu-brd" id="phuong-phap">
                    <div class="container">
                        <header class="edu-head edu-head-light">
                            <span class="edu-head-sub">Phương pháp &amp; Lộ trình</span>
                            <h2 class="edu-display">Giáo trình chuẩn quốc tế</h2>
                            <p class="edu-head-lead">Tài liệu nghiên cứu theo chuẩn Cambridge, cập nhật liên tục.</p>
                        </header>
                    </div>
                    <div class="edu-brd-track" aria-hidden="true">
                        <div class="edu-brd-row">
                            <span>Cambridge English</span><span>Oxford University Press</span><span>Pearson</span>
                            <span>National Geographic Learning</span><span>Macmillan</span><span>British Council</span>
                            <span>Cambridge English</span><span>Oxford University Press</span><span>Pearson</span>
                            <span>National Geographic Learning</span><span>Macmillan</span><span>British Council</span>
                        </div>
                    </div>
                </section>

                <!-- ============ HỌC VIÊN TIÊU BIỂU (tab lọc) ============ -->
                <section class="edu-stu" id="hoc-vien">
                    <div class="container">
                        <t t-set="featured_students" t-value="website._get_landing_students()"/>
                        <header class="edu-head">
                            <span class="edu-head-sub">Mở rộng cơ hội</span>
                            <h2 class="edu-display">Thành tích học viên Kim Academy</h2>
                        </header>
                        <div t-if="featured_students" class="edu-stu-tabs" role="tablist" aria-label="Lọc thành tích">
                            <button type="button" class="edu-stu-tab is-active" role="tab" aria-selected="true" data-filter="all">Tất cả</button>
                            <button type="button" class="edu-stu-tab" role="tab" aria-selected="false" data-filter="ielts">IELTS</button>
                            <button type="button" class="edu-stu-tab" role="tab" aria-selected="false" data-filter="cambridge">Cambridge</button>
                            <button type="button" class="edu-stu-tab" role="tab" aria-selected="false" data-filter="sat">SAT</button>
                        </div>
                        <div t-if="featured_students" class="row g-3 g-lg-4">
                            <div t-foreach="featured_students" t-as="student" class="col-12 col-md-6 edu-stu-col" t-att-data-cat="student.category">
                                <article class="edu-stu-item">
                                    <div class="edu-stu-img">
                                        <img t-att-src="'/web/image/edu.landing.student/%s/image_1920' % student.id" t-att-alt="student.alt_text or student.name" loading="lazy"/>
                                        <span t-if="student.score" class="edu-stu-score"><small t-field="student.display_label"/><b class="edu-display" t-field="student.score"/></span>
                                    </div>
                                    <h3 t-field="student.name"/>
                                    <p t-if="student.school" t-field="student.school"/>
                                    <p t-if="student.description" t-field="student.description"/>
                                </article>
                            </div>
                        </div>
                        <p t-if="featured_students" class="edu-stu-empty text-center text-muted" role="status" hidden="hidden">Chưa có học viên trong nhóm này.</p>
                        <p t-else="" class="text-center text-muted">Thông tin học viên đang được cập nhật.</p>
                    </div>
                </section>

                <!-- ============ CẢM NHẬN ============ -->
                <section class="edu-fm" id="cam-nhan">
                    <div class="container">
                        <header class="edu-head">
                            <span class="edu-head-sub">Cảm nhận</span>
                            <h2 class="edu-display">Phụ huynh và học viên</h2>
                        </header>
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <figure class="edu-fm-item">
                                    <blockquote>Nội dung cảm nhận của phụ huynh. Thay bằng lời chia sẻ thật.</blockquote>
                                    <figcaption><strong>Họ và tên</strong><span>Phụ huynh học viên</span></figcaption>
                                </figure>
                            </div>
                            <div class="col-lg-4">
                                <figure class="edu-fm-item">
                                    <blockquote>Nội dung cảm nhận của học viên. Thay bằng lời chia sẻ thật.</blockquote>
                                    <figcaption><strong>Họ và tên</strong><span>Học viên IELTS</span></figcaption>
                                </figure>
                            </div>
                            <div class="col-lg-4">
                                <figure class="edu-fm-item">
                                    <blockquote>Nội dung cảm nhận của phụ huynh. Thay bằng lời chia sẻ thật.</blockquote>
                                    <figcaption><strong>Họ và tên</strong><span>Phụ huynh học viên</span></figcaption>
                                </figure>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="edu-activities" id="hoat-dong">
                    <div class="container">
                        <t t-set="activities" t-value="website._get_landing_activities()"/>
                        <header class="edu-head">
                            <span class="edu-head-sub">Học viên &amp; Hoạt động</span>
                            <h2 class="edu-display">Hoạt động lớp học</h2>
                            <p class="edu-head-lead" t-if="activities">Những khoảnh khắc học tập, khám phá và kết nối.</p>
                            <p class="edu-head-lead" t-else="">Hình ảnh lớp học, sự kiện và hoạt động tại Kim Academy đang được cập nhật.</p>
                        </header>
                        <div t-if="activities" class="edu-activity-slideshow" role="region" aria-roledescription="trình chiếu" aria-label="Hoạt động lớp học" tabindex="0">
                            <div class="edu-activity-stage" id="edu-activity-slides">
                                <div class="edu-activity-track">
                                <figure t-foreach="activities" t-as="activity" t-attf-class="edu-activity-slide #{'is-active' if activity_first else ''}" t-att-aria-hidden="'false' if activity_first else 'true'" role="group" aria-roledescription="ảnh" t-att-aria-label="'%s / %s' % (activity_index + 1, len(activities))">
                                    <img t-att-src="'/web/image/edu.landing.activity/%s/image_1920' % activity.id" t-att-alt="activity.alt_text or activity.name" loading="lazy" decoding="async"/>
                                </figure>
                                </div>
                            </div>
                            <div t-if="len(activities) &gt; 1" class="edu-activity-controls">
                                <div class="edu-activity-dots" role="group" aria-label="Chọn ảnh">
                                    <button t-foreach="activities" t-as="activity" type="button" class="edu-activity-dot" t-att-aria-label="'Xem ảnh %s: %s' % (activity_index + 1, activity.name)" t-att-aria-pressed="'true' if activity_first else 'false'" aria-controls="edu-activity-slides"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ FORM ĐĂNG KÝ (tạo lead trong CRM) ============ -->
                <t t-call="edu_landing.registration"/>

                <!-- Thanh liên hệ cố định trên điện thoại -->
                <div class="edu-sticky-cta d-lg-none">
                    <a href="#chuong-trinh" class="edu-sticky-course"><i class="fa fa-book me-1" role="img" aria-label=""/> Khoá học</a>
                    <a href="#dang-ky" class="edu-sticky-reg"><i class="fa fa-phone me-1" role="img" aria-label=""/> Tư vấn ngay</a>
                </div>

            </div>
        </xpath>
    </template>

</odoo>
