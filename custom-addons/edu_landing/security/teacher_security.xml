<odoo>
    <record id="teacher_public_rule" model="ir.rule">
        <field name="name">Chỉ đọc giáo viên website đã công bố</field>
        <field name="model_id" ref="model_edu_landing_teacher"/>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
    </record>
    <record id="teacher_designer_rule" model="ir.rule">
        <field name="name">Biên tập viên quản lý giáo viên website</field>
        <field name="model_id" ref="model_edu_landing_teacher"/>
        <field name="groups" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
