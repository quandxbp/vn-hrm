<odoo>
    <record id="activity_public_rule" model="ir.rule">
        <field name="name">Chỉ đọc ảnh highlight của sự kiện đang hoạt động</field>
        <field name="model_id" ref="model_edu_landing_activity"/>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        <field name="domain_force">[('is_published', '=', True), ('event_id.active', '=', True)]</field>
    </record>
    <record id="activity_designer_rule" model="ir.rule">
        <field name="name">Biên tập viên quản lý ảnh hoạt động</field>
        <field name="model_id" ref="model_edu_landing_activity"/>
        <field name="groups" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
