<odoo>
    <record id="shadow_tree" model="ir.ui.view">
        <field name="name">edu.session.review.shadow.tree</field>
        <field name="model">edu.session.review.shadow</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-danger="state == 'failed'" decoration-muted="state == 'skipped'">
                <field name="session_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('upload', 'waiting')"
                       decoration-danger="state == 'failed'"/>
                <field name="g_score_total" string="Điểm Gemini"/>
                <field name="w_score_total" string="Điểm worker"/>
                <field name="score_diff" string="Lệch điểm"/>
                <field name="g_teaching_minutes" string="Phút dạy Gemini"/>
                <field name="w_teaching_minutes" string="Phút dạy worker"/>
                <field name="teaching_diff" string="Lệch phút"/>
                <field name="g_teaching_started_at" string="Bắt đầu (Gemini)" optional="show"/>
                <field name="w_teaching_started_at" string="Bắt đầu (worker)" optional="show"/>
                <field name="wall_minutes" optional="hide"/>
                <field name="error" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="shadow_form" model="ir.ui.view">
        <field name="name">edu.session.review.shadow.form</field>
        <field name="model">edu.session.review.shadow</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Tiếp tục với cùng mã tác vụ" invisible="state != 'failed'"
                            confirm="Tiếp tục gửi/kiểm tra tác vụ này với cùng mã? Worker không xử lý lại video đã xong."/>
                    <field name="state" widget="statusbar" statusbar_visible="upload,waiting,done"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Bản chạy thử song song. Kết quả worker chỉ để so sánh, không thay báo cáo Gemini,
                        không ảnh hưởng cảnh báo thời lượng, khóa tuần hay gợi ý học phí/lương.
                    </div>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="review_id"/>
                            <field name="job_key"/>
                            <field name="error" invisible="not error"/>
                        </group>
                        <group>
                            <field name="uploaded_mb"/><field name="total_mb"/>
                            <field name="worker_stage"/><field name="worker_progress" widget="progressbar"/>
                            <field name="wall_minutes"/><field name="peak_rss_mb"/>
                            <field name="finished_at"/><field name="acked"/>
                        </group>
                    </group>
                    <group string="So sánh số liệu">
                        <group string="Gemini">
                            <field name="g_score_total"/><field name="g_teaching_minutes"/>
                            <field name="g_teaching_started_at"/><field name="g_interaction_level"/>
                        </group>
                        <group string="Worker nội bộ">
                            <field name="w_score_available" invisible="1"/>
                            <field name="w_score_total" invisible="not w_score_available"/>
                            <field name="w_teaching_minutes"/><field name="w_total_minutes"/>
                            <field name="w_teaching_started_at"/><field name="w_interaction_level"/>
                            <field name="score_diff"/><field name="teaching_diff"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nhận xét worker" name="worker">
                            <group>
                                <field name="w_summary"/><field name="w_lesson_content"/>
                                <field name="w_strengths"/><field name="w_improvements"/>
                                <field name="w_timing_note"/><field name="w_timing_details"/>
                                <field name="w_score_details"/>
                            </group>
                        </page>
                        <page string="Học sinh (worker)" name="students">
                            <group>
                                <field name="w_student_alert_count"/>
                                <field name="w_student_report" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Nhận xét Gemini" name="gemini">
                            <group>
                                <field name="review_id" string="Mở báo cáo Gemini"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shadow_search" model="ir.ui.view">
        <field name="name">edu.session.review.shadow.search</field>
        <field name="model">edu.session.review.shadow</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <filter name="done" string="Có kết quả" domain="[('state', '=', 'done')]"/>
                <filter name="running" string="Đang chạy" domain="[('state', 'in', ('upload', 'waiting'))]"/>
                <filter name="failed" string="Lỗi" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="big_score_gap" string="Lệch điểm &gt; 1" domain="['|', ('score_diff', '&gt;', 1), ('score_diff', '&lt;', -1)]"/>
                <filter name="big_time_gap" string="Lệch phút dạy &gt; 2" domain="['|', ('teaching_diff', '&gt;', 2), ('teaching_diff', '&lt;', -2)]"/>
            </search>
        </field>
    </record>

    <record id="action_shadow" model="ir.actions.act_window">
        <field name="name">So sánh worker nội bộ</field>
        <field name="res_model">edu.session.review.shadow</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_done': 1}</field>
    </record>
    <menuitem id="menu_shadow" name="So sánh worker AI" parent="edu_video.menu_video_processing_root"
              action="action_shadow" sequence="21" groups="edu_gvnn.group_edu_manager"/>
</odoo>
