<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="owl.OwlHrmDashboard" owl="1">
        <div class="tbl-home-page w-100" style="margin-top: 10px;-webkit-box-flex: 1;
                -webkit-flex: 1 1 auto;
                flex: 1 1 auto;
                height: 100%;
                overflow: auto;
                position: relative;">
            <div class="main">

            <div class="row" style="">
                <div class="main-left col-md-3">

                    <div class="main-left-user">
                        <div class="left-user-name">
                            <div class="user-avatar">
                                <t t-if="state.employee.id">
                                    <img id="dashboard_avatar" t-att-src="'/web/image?model=hr.employee.public&amp;id=' + state.employee.id + '&amp;field=image_1024'"
                                     alt="Avatar"/>
                                </t>
                                <t t-else="">
                                    <img id="dashboard_avatar" src="/vnpt_hrm_dashboard/static/images/avatar_placeholder.png" alt="Avatar"/>
                                </t>

                            </div>
                            <div class="user-name">
                                <div class="user-name-text" id="dashboard_tendaydu">
                                    <t t-if="state.employee.name" >
                                        <t t-esc="state.employee.name" />
                                    </t>
                                    <t t-else="">
                                        Chưa có thông tin nhân sự
                                    </t>
                                </div>
                                <t t-if="state.employee.code">
                                    <div class="user-name-code" id="dashboard_manhanvien"><t t-esc="state.employee.code" /></div>
                                </t>

                            </div>
                            <div class="clear" />
                        </div>
                        <div class="left-user-info">
                            <div class="user-info-item location">
                                <div class="item-label">Đơn vị</div>
                                <div class="item-text" id="dashboard_phongban">
                                    <t t-if="state.employee.department_name">
                                        <t t-esc="state.employee.department_name" />
                                    </t>
                                    <t t-else="">
                                        <i>(Chưa có dữ liệu)</i>
                                    </t>
                                </div>
                            </div>
                            <div class="user-info-item title">
                                <div class="item-label">Vị trí</div>
                                <div class="item-text" id="dashboard_chucdanh">
                                    <t t-if="state.employee.job_title">
                                        <t t-esc="state.employee.job_title" />
                                    </t>
                                    <t t-else="">
                                        <i>(Chưa có dữ liệu)</i>
                                    </t>
                                </div>
                            </div>
                            <div class="user-info-item email">
                                <div class="item-label">Email</div>
                                <div class="item-text" id="dashboard_email">
                                    <t t-if="state.employee.work_email">
                                        <t t-esc="state.employee.work_email" />
                                    </t>
                                    <t t-else="">
                                        <i>(Chưa có dữ liệu)</i>
                                    </t>
                                </div>
                            </div>
                            <div class="user-info-item phone">
                                <div class="item-label">Di động</div>
                                <div class="item-text" id="dashboard_mobile">
                                    <t t-if="state.employee.work_phone">
                                        <t t-esc="state.employee.work_phone" />
                                    </t>
                                    <t t-else="">
                                        <i>(Chưa có dữ liệu)</i>
                                    </t>
                                </div>
                            </div>
                            <div class="clear" />
                            <div class="row">
                                <div class="clear" />
                            </div>

                        </div>
                        <div class="clear" />
                    </div>
                </div>

