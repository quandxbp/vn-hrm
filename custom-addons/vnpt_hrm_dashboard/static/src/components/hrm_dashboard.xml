<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vnpt_hrm_dashboard.Dashboard">
        <div class="vd">
            <div class="vd-grid">

                <!-- Lời chào -->
                <section class="vd-card vd-hero">
                    <div class="vd-hero-text">
                        <div class="vd-hero-date" t-esc="todayLabel"/>
                        <h1 class="vd-hero-title">
                            <t t-esc="greeting"/><t t-if="firstName">, <span t-esc="firstName"/></t>
                        </h1>
                        <p class="vd-hero-sub" t-if="state.employee.id">
                            <t t-if="state.employee.job_title" t-esc="state.employee.job_title"/>
                            <t t-if="state.employee.job_title and state.employee.department_name"> · </t>
                            <t t-if="state.employee.department_name" t-esc="state.employee.department_name"/>
                        </p>
                        <p class="vd-hero-sub" t-else="">Tài khoản chưa được liên kết với hồ sơ nhân sự.</p>
                    </div>
                    <div class="vd-hero-avatar">
                        <img t-if="state.employee.id"
                             t-att-src="'/web/image?model=hr.employee.public&amp;id=' + state.employee.id + '&amp;field=image_1024'"
                             alt="Ảnh đại diện"/>
                        <img t-else="" src="/vnpt_hrm_dashboard/static/images/avatar_placeholder.png" alt="Ảnh đại diện"/>
                    </div>
                </section>

                <!-- Chỉ số tổng quan (quản lý nhân sự) -->
                <t t-foreach="kpis" t-as="kpi" t-key="kpi.key">
                    <section t-attf-class="vd-card vd-kpi vd-tone-{{ kpi.tone }} {{ kpi.onClick ? 'vd-clickable' : '' }}"
                             t-on-click="kpi.onClick">
                        <span class="vd-kpi-icon"><i t-attf-class="fa {{ kpi.icon }}" role="img"/></span>
                        <div class="vd-kpi-body">
                            <div class="vd-kpi-value" t-esc="kpi.value"/>
                            <div class="vd-kpi-label" t-esc="kpi.label"/>
                        </div>
                    </section>
                </t>

                <!-- Truy cập nhanh -->
                <section class="vd-card vd-quick">
                    <header class="vd-card-head"><h2>Truy cập nhanh</h2></header>
                    <div class="vd-quick-list">
                        <t t-foreach="quickLinks" t-as="link" t-key="link.key">
                            <button type="button" class="vd-quick-item" t-on-click="link.onClick">
                                <img t-att-src="link.icon" alt=""/>
                                <span t-esc="link.label"/>
                            </button>
                        </t>
                    </div>
                </section>

                <!-- Cảnh báo nhân sự -->
                <section class="vd-card vd-alerts" t-if="perms.isContractManager">
                    <header class="vd-card-head"><h2>Cảnh báo nhân sự</h2></header>
                    <ul class="vd-alert-list">
                        <t t-foreach="alertItems" t-as="alert" t-key="alert.key">
                            <li t-attf-class="vd-alert vd-tone-{{ alert.tone }} vd-clickable" t-on-click="alert.onClick">
                                <span class="vd-alert-icon"><i t-attf-class="fa {{ alert.icon }}" role="img"/></span>
                                <span class="vd-alert-label" t-esc="alert.label"/>
                                <span class="vd-alert-count" t-esc="alert.count"/>
                                <i class="fa fa-angle-right vd-alert-go" role="img"/>
                            </li>
                        </t>
                    </ul>
                </section>

                <!-- Biểu đồ -->
                <t t-if="state.stats">
                    <section class="vd-card vd-chart-hires">
                        <header class="vd-card-head">
                            <h2>Nhân sự mới theo tháng</h2>
                            <span class="vd-card-hint">6 tháng gần nhất</span>
                        </header>
                        <DashboardChart type="'bar'" labels="hiresChart.labels" values="hiresChart.values"
                                        tones="['primary']" datasetLabel="'Nhân sự mới'"/>
                    </section>

                    <section class="vd-card vd-chart-contracts">
                        <header class="vd-card-head"><h2>Hợp đồng</h2></header>
                        <t t-if="hasData(contractChart)">
                            <DashboardChart type="'doughnut'" labels="contractChart.labels"
                                            values="contractChart.values" tones="contractChart.tones"/>
                        </t>
                        <div class="vd-empty" t-else="">Chưa có dữ liệu hợp đồng</div>
                    </section>

                    <section class="vd-card vd-chart-departments">
                        <header class="vd-card-head">
                            <h2>Nhân sự theo phòng ban</h2>
                            <span class="vd-card-hint">Top 8</span>
                        </header>
                        <t t-if="hasData(departmentChart)">
                            <DashboardChart type="'hbar'" labels="departmentChart.labels"
                                            values="departmentChart.values"
                                            tones="['primary', 'info', 'success']"/>
                        </t>
                        <div class="vd-empty" t-else="">Chưa có dữ liệu phòng ban</div>
                    </section>
                </t>

                <!-- Sinh nhật -->
                <section class="vd-card vd-birthdays">
                    <header class="vd-card-head">
                        <h2>Sinh nhật hôm nay</h2>
                        <span class="vd-card-hint" t-if="state.birthdayEmpls.length" t-esc="state.birthdayEmpls.length"/>
                    </header>
                    <ul class="vd-birthday-list" t-if="state.birthdayEmpls.length">
                        <t t-foreach="state.birthdayEmpls" t-as="person" t-key="person.id">
                            <li class="vd-person">
                                <img t-att-src="'/web/image?model=hr.employee.public&amp;id=' + person.id + '&amp;field=image_128'"
                                     alt=""/>
                                <div class="vd-person-text">
                                    <div class="vd-person-name" t-esc="person.name"/>
                                    <div class="vd-person-sub" t-esc="person.job_title or ''"/>
                                </div>
                                <a t-if="person.work_email" class="vd-person-action"
                                   t-att-href="'mailto:' + person.work_email" title="Gửi lời chúc">
                                    <i class="fa fa-birthday-cake" role="img"/>
                                </a>
                            </li>
                        </t>
                    </ul>
                    <div class="vd-empty" t-else="">
                        <i class="fa fa-smile-o" role="img"/>
                        <span>Hôm nay không có ai sinh nhật</span>
                    </div>
                </section>

                <!-- Thông tin liên hệ -->
                <section class="vd-card vd-contact" t-if="state.employee.id">
                    <header class="vd-card-head"><h2>Thông tin của tôi</h2></header>
                    <dl class="vd-contact-list">
                        <div class="vd-contact-row" t-if="state.employee.code">
                            <dt><i class="fa fa-id-badge" role="img"/> Mã nhân viên</dt>
                            <dd t-esc="state.employee.code"/>
                        </div>
                        <div class="vd-contact-row">
                            <dt><i class="fa fa-building-o" role="img"/> Đơn vị</dt>
                            <dd><t t-esc="state.employee.department_name or '(Chưa có dữ liệu)'"/></dd>
                        </div>
                        <div class="vd-contact-row">
                            <dt><i class="fa fa-briefcase" role="img"/> Vị trí</dt>
                            <dd><t t-esc="state.employee.job_title or '(Chưa có dữ liệu)'"/></dd>
                        </div>
                        <div class="vd-contact-row">
                            <dt><i class="fa fa-envelope-o" role="img"/> Email</dt>
                            <dd><t t-esc="state.employee.work_email or '(Chưa có dữ liệu)'"/></dd>
                        </div>
                        <div class="vd-contact-row">
                            <dt><i class="fa fa-phone" role="img"/> Di động</dt>
                            <dd><t t-esc="state.employee.work_phone or '(Chưa có dữ liệu)'"/></dd>
                        </div>
                    </dl>
                </section>

            </div>
        </div>
    </t>

</templates>
