                        <!-- CẢNH BÁO HỢP ĐỒNG-->
                        <div class="right-item dashboard-canvas-item" t-if="isContractManager">
                            <div class="item-head">
                                <div class="item-head-text">CẢNH BÁO NHÂN SỰ</div>
