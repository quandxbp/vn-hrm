                                            <div class="button-title-text">Hợp đồng gần hết hạn</div>
                                        </div>
                                    </div>

                                    <div class="canhbaonhansu-item col-4">
                                        <a class="button hethanhopdong"
                                           href="/web#action=vnpt_hrm.action_close_hr_contract">
                                            <img src="/vnpt_hrm_dashboard/static/images/icon/icon_hethanhopdong.png" />
