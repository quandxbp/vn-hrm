                        <div class="right-item dashboard-canvas-item" data-id="544134">
                            <div class="item-head">
                                <div class="item-head-text">CHÚC MỪNG SINH NHẬT</div>
                                <div class="clear" />
                            </div>
                            <div class="item-body" id="box-dashboard-sinhnhat-content">
                                <t t-if="state.birthdayEmpls.length">
                                    <t t-foreach="state.birthdayEmpls" t-as="birthday" t-key="birthday.id">
                                        <div class="birthday-item row">
                                            <div class="col-1 float-left">
                                                <div class="user-avatar ">
                                                    <div class="user-avatar-cover">

                                                        <img t-att-src="'/web/image?model=hr.employee.public&amp;id=' + birthday.id + '&amp;field=image_1024'" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="user-text col-9">
                                                <div class="user-text-name text-primary" t-esc="birthday.name" />
                                                <div class="user-text-label" t-esc="birthday.job_title" />
                                                <div class="user-text-label" t-esc="birthday.department_name"/>
                                            </div>
                                            <div class="birthday-item-action col-2 text-center">
                                                <button class="btn btn-primary btn-sm float-right mt-2" type="button">Chúc mừng</button>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div id="no-content-sinhnhat">Không có nhân viên sinh nhật ngày hôm nay!</div>
                                </t>
                            </div>
                            <div class="clear" />
                        </div>



