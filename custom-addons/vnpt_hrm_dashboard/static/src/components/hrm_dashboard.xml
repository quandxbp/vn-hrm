                                        <div class="canhbaonhansu-item-title">
                                            <div class="button-title-nubmer" id="number_nhansuhethanhopdong">
                                                <t t-esc="state.alerts.expiredContracts" />
                                            </div>
                                            <div class="button-title-text">Hợp đồng hết hạn</div>
                                        </div>
                                    </div>

                                    <div class="canhbaonhansu-item col-4" t-on-click="openSalaryIncreaseContracts">
                                        <div class="button nangluongchinhsach">
                                            <img src="/vnpt_hrm_dashboard/static/images/icon/icon_nangluongchinhsach.png" />
                                        </div>
                                        <div class="canhbaonhansu-item-title">
                                            <div class="button-title-nubmer" id="number_nangluongchinhsach">
                                                <t t-esc="state.alerts.salaryIncrease" />
                                            </div>
                                            <div class="button-title-text">Cảnh báo nâng lương</div>
                                        </div>
                                    </div>
                                </div>
