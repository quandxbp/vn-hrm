<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="action_owl_hrm_dashboard" model="ir.actions.client">
            <field name="name">Trang chủ</field>
            <field name="tag">owl.vnpt_hrm_dashboard</field>
        </record>

        <record id="hr_holidays.hr_leave_action_my" model="ir.actions.act_window">
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Theo dõi ngày nghỉ phép của bạn.
                </p><p>
                    Một cách tuyệt vời để quản lý yêu cầu nghỉ phép, ngày ốm và trạng thái phê duyệt.
                </p>
            </field>
        </record>

        <menuitem name="Trang chủ"
                  id="vnpt_hrm_dashboard_root_menu"
                  web_icon="vnpt_hrm_dashboard,static/description/icon.png" sequence="1">
            <menuitem name="Tổng quan"
                      id="menu_vnpt_hrm_dashboard" sequence="1"
                      action="action_owl_hrm_dashboard"/>

            <menuitem name="Danh bạ nhân sự"
                      id="menu_vnpt_hrm_employee_public" sequence="2"
                      action="hr.hr_employee_public_action"/>

            <menuitem name="Sơ đồ tổ chức"
                      id="menu_vnpt_hrm_employee_org_chart" sequence="3"
                      groups="base.group_user"
                      action="hr_org_chart.action_hr_employee_org_chart"/>
        </menuitem>

    </data>
</odoo>