<odoo noupdate="1">
    <record id="cron_review" model="ir.cron">
        <field name="name">GVNN: nhận xét AI buổi học</field>
        <field name="model_id" ref="model_edu_session_review"/>
        <field name="state">code</field><field name="code">model._cron_process()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
        <field name="numbercall">-1</field><field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_review_cleanup" model="ir.cron">
        <field name="name">GVNN: dọn dữ liệu tạm nhận xét AI</field>
        <field name="model_id" ref="model_edu_session_review"/>
        <field name="state">code</field><field name="code">model._cron_cleanup()</field>
        <field name="interval_number">15</field><field name="interval_type">minutes</field>
        <field name="numbercall">-1</field><field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
