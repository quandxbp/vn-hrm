<odoo>
    <record id="review_form" model="ir.ui.view">
        <field name="name">edu.session.review.form</field><field name="model">edu.session.review</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" class="edu_review_form">
                <header>
                    <button name="action_cancel" type="object" string="Hủy phân tích" invisible="state in ['done','failed','cancelled']"/>
                    <button name="action_reanalyze" type="object" string="Phân tích lại" class="btn-primary" invisible="state not in ['done','failed','cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,processing,analyzing,done"/>
                </header>
                <sheet>
                    <div class="edu_review_heading">
                        <span class="edu_review_eyebrow">CHẤT LƯỢNG BUỔI DẠY</span>
                        <h1><field name="session_id" nolabel="1"/></h1>
                        <p>Thời gian thực dạy, nội dung bài học và nhận xét có dẫn chứng.</p>
                    </div>
                    <field name="source_current" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="source_current">
                        Link Drive đã thay đổi. Báo cáo này thuộc phiên bản video trước; hãy phân tích lại.
                    </div>
                    <div class="alert alert-warning" invisible="state != 'done' or prompt_version == '2.0'">
                        Báo cáo theo tiêu chí cũ, chưa có nội dung chi tiết và điểm /10. Bấm Phân tích lại để cập nhật.
                    </div>
                    <div class="alert alert-danger" invisible="not error"><field name="error" nolabel="1"/></div>
                    <div class="alert alert-info" invisible="state in ['done','failed','cancelled']">
                        Đang xử lý video và tạo báo cáo. Bạn có thể quay lại buổi học trong lúc chờ.
                    </div>
                    <field name="sufficient_data" invisible="1"/><field name="score_available" invisible="1"/>
                    <div invisible="state != 'done'">
                        <div class="edu_review_metrics">
                            <div class="edu_review_metric edu_review_metric_time">
                                <span class="edu_review_label">01 · GIẢNG DẠY / TỔNG VIDEO</span>
                                <field name="time_display" nolabel="1" class="edu_review_value"/>
                                <span class="edu_review_caption">phút:giây · Tổng các phần video</span>
                                <field name="ratio_display" nolabel="1"/>
                                <div invisible="not sufficient_data">Bắt đầu dạy: <field name="teaching_started_at" nolabel="1"/></div>
                            </div>
                            <div class="edu_review_metric edu_review_metric_score">
                                <span class="edu_review_label">ĐIỂM CHẤT LƯỢNG BUỔI DẠY</span>
                                <field name="score_display" nolabel="1" class="edu_review_value"/>
                                <span class="edu_review_caption">4 tiêu chí · Mỗi tiêu chí tối đa 2,5 điểm</span>
                                <div>Mức tương tác: <field name="interaction_level" widget="badge" nolabel="1"/></div>
                            </div>
                        </div>
                        <div class="edu_review_section">
                            <h2>Nhận xét tổng quát</h2>
                            <field name="summary" nolabel="1" class="edu_review_prose"/>
                        </div>
                        <div class="edu_review_section">
                            <h2>02 · Nội dung giáo viên đã dạy</h2>
                            <field name="lesson_content" nolabel="1" class="edu_review_prose"/>
                            <p invisible="lesson_content" class="text-muted">Báo cáo này chưa có nội dung bài dạy chi tiết.</p>
                        </div>
                        <div class="edu_review_columns">
                            <div class="edu_review_section edu_review_strengths">
                                <h2>03 · Ưu điểm</h2><field name="strengths" nolabel="1" class="edu_review_prose"/>
                            </div>
                            <div class="edu_review_section edu_review_improvements">
                                <h2>Điểm cần cải thiện</h2><field name="improvements" nolabel="1" class="edu_review_prose"/>
                            </div>
                        </div>
                        <div class="edu_review_section" invisible="not score_details">
                            <h2>04 · Chi tiết chấm điểm</h2>
                            <group invisible="not score_available" col="4">
                                <field name="score_content"/><field name="score_instruction"/>
                                <field name="score_interaction"/><field name="score_management"/>
                            </group>
                            <field name="score_details" nolabel="1" class="edu_review_prose"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="Thời gian và dẫn chứng" invisible="state != 'done'">
                            <group><field name="teaching_started_at"/><field name="teaching_minutes"/><field name="total_minutes"/></group>
                            <div class="edu_review_section"><h3>Căn cứ tính thời gian</h3><field name="timing_note" nolabel="1" class="edu_review_prose"/>
                                <field name="timing_details" nolabel="1" class="edu_review_prose"/></div>
                            <div class="edu_review_section"><h3>Tương tác với học sinh</h3><field name="interaction_comment" nolabel="1" class="edu_review_prose"/></div>
                            <group><field name="quality_note"/></group>
                        </page>
                        <page string="Video nguồn">
                            <field name="part_ids" nolabel="1">
                                <tree create="0" delete="0"><field name="number"/><field name="source_url" widget="url"/><field name="state"/><field name="duration"/></tree>
                            </field>
                        </page>
                        <page string="Thông tin phân tích">
                            <group>
                                <group><field name="name"/><field name="requested_by"/><field name="create_date" string="Thời gian yêu cầu"/><field name="finished_at"/></group>
                                <group><field name="model_name"/><field name="prompt_version"/><field name="cleanup_pending"/></group>
                            </group>
                        </page>
                    </notebook>
                    <p class="edu_review_footnote">AI đánh giá nội dung quan sát được trong video. Thời gian và điểm số là ước lượng để quản lý kiểm tra cùng các mốc dẫn chứng.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="session_review_page" model="ir.ui.view">
        <field name="name">edu.session.ai.review</field><field name="model">edu.session</field>
        <field name="inherit_id" ref="edu_gvnn.view_edu_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="ai_review" string="Nhận xét AI" groups="edu_gvnn.group_edu_manager">
                    <field name="ai_review_id" invisible="1"/><field name="ai_review_current" invisible="1"/>
                    <div class="edu_session_review_panel">
                        <div class="edu_session_review_header">
                            <div class="edu_session_review_intro">
                                <span class="edu_session_review_icon fa fa-magic" aria-hidden="true"/>
                                <div>
                                    <span class="edu_session_review_eyebrow">ĐÁNH GIÁ BUỔI DẠY</span>
                                    <h3>Nhận xét AI</h3>
                                    <p>Nội dung bài dạy, chất lượng giảng dạy và góp ý có dẫn chứng.</p>
                                </div>
                            </div>
                            <div class="edu_session_review_actions">
                                <button name="action_open_ai_review" type="object" string="Mở chi tiết" icon="fa-external-link"
                                        class="btn-primary" invisible="not ai_review_id"/>
                                <button name="action_analyze_lesson" type="object" string="Phân tích buổi học" icon="fa-magic"
                                        class="btn-primary" invisible="ai_review_id or state == 'cancel'"
                                        help="Gửi video Drive của buổi học đến Gemini để tạo nhận xét."/>
                                <button name="action_analyze_lesson" type="object" string="Phân tích lại" icon="fa-refresh"
                                        class="btn-outline-secondary" invisible="not ai_review_id or state == 'cancel' or ai_review_state in ['queued','processing','analyzing']"
                                        help="Tạo một lần đánh giá mới từ các video Drive hiện tại."/>
                            </div>
                        </div>
                        <div class="edu_session_review_status" invisible="not ai_review_id">
                            <span>PHÂN TÍCH MỚI NHẤT</span>
                            <field name="ai_review_state" widget="badge" nolabel="1"
                                   decoration-success="ai_review_state == 'done'" decoration-danger="ai_review_state == 'failed'"
                                   decoration-info="ai_review_state in ['queued','processing','analyzing']"
                                   decoration-muted="ai_review_state == 'cancelled'"/>
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not ai_review_id or ai_review_current">
                            Link Drive đã thay đổi. Nhận xét bên dưới thuộc video trước; hãy phân tích lại để cập nhật.
                        </div>
                        <div class="edu_session_review_empty" invisible="ai_review_id">
                            <span class="fa fa-file-text-o" aria-hidden="true"/>
                            <h4>Chưa có nhận xét cho buổi học này</h4>
                            <p>Thêm link Google Drive trong tab Video buổi học, rồi chọn Phân tích buổi học.</p>
                            <small>Báo cáo gồm thời gian thực dạy, nội dung đã dạy, ưu điểm, góp ý và điểm /10.</small>
                        </div>
                        <div class="alert alert-info" role="status" invisible="not ai_review_id or ai_review_state not in ['queued','processing','analyzing']">
                            <i class="fa fa-clock-o me-2" aria-hidden="true"/>Video đang được xử lý. Bạn có thể tiếp tục làm việc và quay lại xem kết quả.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="ai_review_state != 'failed'">
                            Phân tích chưa hoàn tất. Mở chi tiết để xem nguyên nhân hoặc chọn Phân tích lại.
                        </div>
                        <div class="alert alert-secondary" invisible="ai_review_state != 'cancelled'">Lần phân tích này đã được hủy. Bạn có thể phân tích lại khi cần.</div>
                        <div class="edu_session_review_metrics" invisible="ai_review_state != 'done'">
                            <div class="edu_session_review_metric edu_session_review_time">
                                <span class="edu_session_review_label"><i class="fa fa-clock-o me-2" aria-hidden="true"/>GIẢNG DẠY / TỔNG VIDEO</span>
                                <field name="ai_review_time" nolabel="1" class="edu_session_review_value"/>
                                <small>Phút:giây · Ước lượng hoạt động dạy và học thực tế</small>
                            </div>
                            <div class="edu_session_review_metric edu_session_review_score">
                                <span class="edu_session_review_label"><i class="fa fa-star-o me-2" aria-hidden="true"/>ĐIỂM CHẤT LƯỢNG</span>
                                <field name="ai_review_score" nolabel="1" class="edu_session_review_value"/>
                                <small>Nội dung · Hướng dẫn · Tương tác · Tổ chức</small>
                            </div>
                        </div>
                        <div class="edu_session_review_summary" invisible="ai_review_state != 'done' or not ai_review_summary">
                            <h4>Nhận xét tổng quát</h4>
                            <field name="ai_review_summary" nolabel="1" class="edu_session_review_prose"/>
                            <p class="edu_session_review_hint">Mở chi tiết để xem nội dung đã dạy, ưu điểm, góp ý và căn cứ chấm điểm.</p>
                        </div>
                        <details class="edu_session_review_history" invisible="not ai_review_id">
                            <summary><i class="fa fa-history me-2" aria-hidden="true"/>Lịch sử phân tích</summary>
                            <field name="ai_review_ids" nolabel="1" readonly="1">
                                <tree create="0" delete="0" default_order="id desc">
                                    <field name="create_date" string="Thời gian"/><field name="requested_by" string="Người yêu cầu"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                                    <field name="time_display" string="Giảng dạy / video"/><field name="score_display" string="Điểm /10"/>
                                    <button name="get_formview_action" type="object" string="Chi tiết" icon="fa-external-link" class="btn-link"/>
                                </tree>
                            </field>
                        </details>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="review_config_form" model="ir.ui.view">
        <field name="name">edu.video.config.review</field><field name="model">edu.video.config</field>
        <field name="inherit_id" ref="edu_video.view_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="Nhận xét AI buổi học — Gemini"/>
                <div class="alert alert-info" role="status">
                    Khi bật phân tích, video Drive được gửi đến Google Gemini để tạo nhận xét nội bộ.
                    Không cần đăng công khai video. API key Gemini độc lập với OAuth Drive/YouTube.
                    Chỉ các link mới/thay đổi được tự xếp hàng; không tự phân tích các video cũ.
                </div>
                <group>
                    <group><field name="review_key_input" password="True" placeholder="Nhập key để thay; để trống giữ key hiện có"/>
                        <field name="review_key_set"/><field name="review_model"/>
                        <button name="action_test_review_connection" type="object" string="Kiểm tra kết nối Gemini"/>
                        <button name="action_clear_review_key" type="object" string="Xóa API key Gemini" confirm="Tắt phân tích và xóa key đã lưu?"/>
                    </group>
                    <group><field name="review_enabled"/><field name="review_auto"/>
                        <field name="review_max_mb"/><field name="review_max_minutes"/></group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
