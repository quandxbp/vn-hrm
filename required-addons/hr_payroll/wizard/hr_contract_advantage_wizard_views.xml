<odoo>
    <record id="view_hr_contract_advantage_wizard_form" model="ir.ui.view">
        <field name="name">hr.contract.advantage.wizard.form</field>
        <field name="model">hr.contract.advantage.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật phụ cấp hợp đồng" class="oe_form">
                <!-- Cảnh báo màu vàng -->
                <div class="alert alert-warning text-center" role="alert">
                    Hành động này sẽ tạo phụ cấp hợp đồng cho tất cả hợp đồng được chọn.
                    Nếu một mẫu phụ cấp đã tồn tại trên hợp đồng, nó sẽ chỉ được cập nhật số tiền.
                </div>

                <group>
                    <field name="currency_id" invisible="1" />
                    <field name="advantage_template_id" required="1" context="{'default_active': True}"/>
                    <field name="amount" widget="monetary" />
                </group>

                <separator string="Hợp đồng"/>
                <field name="contract_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="company_id" column_invisible="1" />
                        <field name="name" string="Tham chiếu hợp đồng"/>
                        <field name="employee_id" string="Nhân viên"/>
                        <field name="job_id" string="Chức vụ"/>
                        <field name="department_id" string="Phòng ban"/>
                        <field name="state" string="Trạng thái"
                               widget="label_selection" options="{'classes': {'draft': 'primary', 'open': 'success', 'close': 'default', 'cancel': 'danger'}}"/>
                    </tree>
                </field>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"/>
                    <button string="Hủy"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
